SCHEMA = """
PRAGMA journal_mode=WAL;
PRAGMA foreign_keys=ON;
CREATE TABLE IF NOT EXISTS repositories (
  id TEXT PRIMARY KEY,
  canonical_path TEXT NOT NULL UNIQUE,
  remote_url TEXT,
  created_at TEXT NOT NULL,
  last_seen_at TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS runs (
  id TEXT PRIMARY KEY,
  repository_id TEXT NOT NULL REFERENCES repositories(id),
  started_at TEXT NOT NULL,
  finished_at TEXT,
  requested_hours REAL NOT NULL,
  status TEXT NOT NULL,
  branch TEXT,
  head_sha TEXT NOT NULL,
  remote_head_sha TEXT,
  dirty INTEGER NOT NULL,
  previous_audited_sha TEXT,
  primary_model TEXT,
  challenger_model TEXT,
  error TEXT
);
CREATE TABLE IF NOT EXISTS hypotheses (
  id TEXT PRIMARY KEY,
  run_id TEXT NOT NULL REFERENCES runs(id),
  subsystem TEXT,
  lens TEXT,
  title TEXT NOT NULL,
  hypothesis TEXT NOT NULL,
  priority REAL NOT NULL DEFAULT 0,
  status TEXT NOT NULL,
  created_at TEXT NOT NULL,
  completed_at TEXT
);
CREATE TABLE IF NOT EXISTS evidence (
  id TEXT PRIMARY KEY,
  hypothesis_id TEXT NOT NULL REFERENCES hypotheses(id),
  kind TEXT NOT NULL,
  source TEXT NOT NULL,
  content TEXT NOT NULL,
  sha256 TEXT NOT NULL,
  created_at TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS findings (
  id TEXT PRIMARY KEY,
  run_id TEXT NOT NULL REFERENCES runs(id),
  hypothesis_id TEXT REFERENCES hypotheses(id),
  fingerprint TEXT NOT NULL,
  title TEXT NOT NULL,
  subsystem TEXT,
  lens TEXT,
  severity TEXT NOT NULL,
  confidence REAL NOT NULL,
  evidence_level TEXT NOT NULL,
  invariant TEXT,
  observed TEXT NOT NULL,
  expected TEXT,
  impact TEXT,
  recommendation TEXT,
  challenger_verdict TEXT,
  challenger_reason TEXT,
  status TEXT NOT NULL,
  first_seen_at TEXT NOT NULL,
  last_seen_at TEXT NOT NULL
);
CREATE INDEX IF NOT EXISTS idx_findings_fp ON findings(fingerprint);
CREATE TABLE IF NOT EXISTS rejections (
  id TEXT PRIMARY KEY,
  run_id TEXT NOT NULL REFERENCES runs(id),
  hypothesis_id TEXT REFERENCES hypotheses(id),
  reason TEXT NOT NULL,
  created_at TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS coverage (
  repository_id TEXT NOT NULL REFERENCES repositories(id),
  subsystem TEXT NOT NULL,
  lens TEXT NOT NULL,
  score REAL NOT NULL DEFAULT 0,
  investigations INTEGER NOT NULL DEFAULT 0,
  last_run_id TEXT,
  updated_at TEXT NOT NULL,
  PRIMARY KEY(repository_id, subsystem, lens)
);
CREATE TABLE IF NOT EXISTS model_calls (
  id TEXT PRIMARY KEY,
  run_id TEXT REFERENCES runs(id),
  hypothesis_id TEXT REFERENCES hypotheses(id),
  role TEXT NOT NULL,
  operation TEXT NOT NULL,
  model TEXT NOT NULL,
  started_at TEXT NOT NULL,
  duration_ms INTEGER NOT NULL,
  success INTEGER NOT NULL,
  response_sha256 TEXT,
  error TEXT
);
CREATE TABLE IF NOT EXISTS tool_calls (
  id TEXT PRIMARY KEY,
  run_id TEXT REFERENCES runs(id),
  hypothesis_id TEXT REFERENCES hypotheses(id),
  tool TEXT NOT NULL,
  request_json TEXT NOT NULL,
  started_at TEXT NOT NULL,
  duration_ms INTEGER NOT NULL,
  success INTEGER NOT NULL,
  output_sha256 TEXT,
  error TEXT
);
CREATE TABLE IF NOT EXISTS repository_intelligence_cache (
  repository_id TEXT NOT NULL REFERENCES repositories(id),
  head_sha TEXT NOT NULL,
  primary_model TEXT NOT NULL,
  input_sha256 TEXT NOT NULL,
  intelligence_json TEXT NOT NULL,
  source_run_id TEXT NOT NULL,
  created_at TEXT NOT NULL,
  PRIMARY KEY(repository_id, head_sha, primary_model, input_sha256)
);
CREATE TABLE IF NOT EXISTS run_activity (
  run_id TEXT PRIMARY KEY REFERENCES runs(id) ON DELETE CASCADE,
  stage TEXT NOT NULL,
  detail TEXT,
  pid INTEGER NOT NULL,
  updated_at TEXT NOT NULL
);
"""


def now() -> str:
    return dt.datetime.now(dt.timezone.utc).isoformat()


def ensure_dirs() -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    REPORT_DIR.mkdir(parents=True, exist_ok=True)
    EVIDENCE_DIR.mkdir(parents=True, exist_ok=True)
    if not CONFIG_PATH.exists():
        CONFIG_PATH.write_text(json.dumps(DEFAULT_CONFIG, indent=2) + "\n")


def deep_merge(base: dict[str, Any], update: dict[str, Any]) -> dict[str, Any]:
    out = json.loads(json.dumps(base))
    for key, value in update.items():
        if isinstance(value, dict) and isinstance(out.get(key), dict):
            out[key] = deep_merge(out[key], value)
        else:
            out[key] = value
    return out


def load_config() -> dict[str, Any]:
    ensure_dirs()
    cfg = json.loads(CONFIG_PATH.read_text())
    return deep_merge(DEFAULT_CONFIG, cfg)


def db() -> sqlite3.Connection:
    ensure_dirs()
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    conn.executescript(SCHEMA)
    return conn


def run_cmd(argv: list[str], cwd: pathlib.Path, timeout: int = 30, check: bool = True) -> subprocess.CompletedProcess[str]:
    p = subprocess.run(argv, cwd=str(cwd), text=True, capture_output=True, timeout=timeout)
    if check and p.returncode != 0:
        raise RuntimeError(f"command failed ({p.returncode}): {' '.join(argv)}\n{p.stderr.strip()}")
    return p


def git_root(path: pathlib.Path) -> pathlib.Path:
    path = path.expanduser().resolve()
    out = run_cmd(["git", "rev-parse", "--show-toplevel"], path).stdout.strip()
    return pathlib.Path(out).resolve()


def git_text(root: pathlib.Path, *args: str, check: bool = True) -> str:
    return run_cmd(["git", *args], root, check=check).stdout.strip()


def repo_id(root: pathlib.Path) -> str:
    return hashlib.sha256(str(root).encode()).hexdigest()[:24]


def snapshot(root: pathlib.Path) -> dict[str, Any]:
    head = git_text(root, "rev-parse", "HEAD")
    branch = git_text(root, "branch", "--show-current", check=False) or "DETACHED"
    status = git_text(root, "status", "--porcelain", check=False)
    remote_url = git_text(root, "remote", "get-url", "origin", check=False) or None
    remote_head = None
    if remote_url:
        p = run_cmd(["git", "ls-remote", "origin", "HEAD"], root, timeout=20, check=False)
        if p.returncode == 0 and p.stdout.strip():
            remote_head = p.stdout.split()[0]
    return {
        "root": str(root), "head": head, "branch": branch,
        "dirty": bool(status), "status": status, "remote_url": remote_url,
        "remote_head": remote_head,
    }


def upsert_repo(conn: sqlite3.Connection, snap: dict[str, Any]) -> str:
    rid = repo_id(pathlib.Path(snap["root"]))
    ts = now()
    conn.execute(
        "INSERT INTO repositories(id,canonical_path,remote_url,created_at,last_seen_at) VALUES(?,?,?,?,?) "
        "ON CONFLICT(canonical_path) DO UPDATE SET remote_url=excluded.remote_url,last_seen_at=excluded.last_seen_at",
        (rid, snap["root"], snap["remote_url"], ts, ts),
    )
    conn.commit()
    return rid


def previous_audited_sha(conn: sqlite3.Connection, rid: str) -> str | None:
    row = conn.execute(
        "SELECT head_sha FROM runs WHERE repository_id=? AND status='COMPLETED' ORDER BY started_at DESC LIMIT 1", (rid,)
    ).fetchone()
    return row[0] if row else None


class RunProgress:
    def __init__(self, conn: sqlite3.Connection, run_id: str, heartbeat_seconds: int = 20):
        self.conn = conn
        self.run_id = run_id
        self.heartbeat_seconds = max(5, int(heartbeat_seconds))
        self.stage = "starting"
        self.detail = ""

    @staticmethod
    def _clock() -> str:
        return dt.datetime.now().astimezone().strftime("%H:%M:%S")

    def update(self, stage: str, detail: str = "", *, print_line: bool = True) -> None:
        self.stage = stage
        self.detail = detail
        self.conn.execute(
            "INSERT INTO run_activity(run_id,stage,detail,pid,updated_at) VALUES(?,?,?,?,?) "
            "ON CONFLICT(run_id) DO UPDATE SET stage=excluded.stage,detail=excluded.detail,pid=excluded.pid,updated_at=excluded.updated_at",
            (self.run_id, stage, detail, os.getpid(), now()),
        )
        self.conn.commit()
        if print_line:
            suffix = f" — {detail}" if detail else ""
            print(f"[{self._clock()}] {stage}{suffix}", flush=True)

    def heartbeat(self, detail: str) -> None:
        self.update(self.stage, detail, print_line=False)
        print(f"[{self._clock()}] {detail}", flush=True)


def safe_repo_path(root: pathlib.Path, rel: str) -> pathlib.Path:
    p = (root / rel).resolve()
    try:
        p.relative_to(root)
    except ValueError:
        raise ValueError(f"path escapes repository: {rel}")
    return p


class ToolBroker:
    def __init__(self, root: pathlib.Path, cfg: dict[str, Any]):
        self.root = root
        self.cfg = cfg
        self.max_file = int(cfg["limits"]["max_file_bytes"])
        self.max_search = int(cfg["limits"]["max_search_output_bytes"])

    def tree(self) -> str:
        p = run_cmd(["git", "ls-files"], self.root, timeout=30, check=False)
        return p.stdout[:self.max_search]

    def read(self, rel: str, start: int | None = None, end: int | None = None) -> str:
        p = safe_repo_path(self.root, rel)
        if not p.is_file():
            raise ValueError(f"not a file: {rel}")
        if p.stat().st_size > self.max_file:
            raise ValueError(f"file exceeds read cap ({self.max_file} bytes): {rel}")
        text = p.read_text(errors="replace")
        lines = text.splitlines()
        a = max(1, int(start or 1))
        b = min(len(lines), int(end or len(lines)))
        if b < a:
            raise ValueError("end must be >= start")
        return "\n".join(f"{i+1}: {lines[i]}" for i in range(a-1, b))

    def search(self, query: str, rel: str = ".") -> str:
        if not query or len(query) > 500:
            raise ValueError("invalid search query")
        target = safe_repo_path(self.root, rel)
        args = ["rg", "-n", "--hidden", "--glob", "!.git", "--", query, str(target)]
        p = run_cmd(args, self.root, timeout=45, check=False)
        if p.returncode not in (0, 1):
            raise RuntimeError(p.stderr.strip() or "rg failed")
        return p.stdout[:self.max_search]

    def git(self, args: list[str]) -> str:
        allowed = {"log", "show", "diff", "status", "blame", "rev-parse", "branch"}
        if not args or args[0] not in allowed:
            raise ValueError("Git subcommand not permitted")
        if len(args) > 20 or any(len(x) > 1000 for x in args):
            raise ValueError("Git request too large")
        p = run_cmd(["git", *args], self.root, timeout=60, check=False)
        return (p.stdout + ("\nSTDERR:\n" + p.stderr if p.stderr else ""))[:self.max_search]

    def verify(self, command_name: str) -> str:
        choices = {x.get("name"): x for x in self.cfg.get("verification_commands", []) if isinstance(x, dict)}
        item = choices.get(command_name)
        if not item:
            raise ValueError(f"verification command not allowlisted: {command_name}")
        argv = item.get("argv")
        if not isinstance(argv, list) or not argv or not all(isinstance(x, str) for x in argv):
            raise ValueError("invalid verification command configuration")
        timeout = min(int(item.get("timeout_seconds", 900)), 3600)
        p = run_cmd(argv, self.root, timeout=timeout, check=False)
        out = f"exit={p.returncode}\nSTDOUT:\n{p.stdout}\nSTDERR:\n{p.stderr}"
        return out[:self.max_search]

    def execute_request(self, req: dict[str, Any]) -> tuple[str, str, str]:
        tool = str(req.get("tool", ""))
        if tool == "search":
            query = str(req.get("query", "")); rel = str(req.get("path", "."))
            return "search", f"{rel}:{query}", self.search(query, rel)
        if tool == "read":
            rel = str(req.get("path", ""))
            start = req.get("start"); end = req.get("end")
            return "file", rel, self.read(rel, start, end)
        if tool == "git":
            args = req.get("args", [])
            if not isinstance(args, list) or not all(isinstance(x, str) for x in args):
                raise ValueError("git args must be a string array")
            return "git", "git " + " ".join(args), self.git(args)
        if tool == "verify":
            name = str(req.get("name", ""))
            return "verification", name, self.verify(name)
        raise ValueError(f"tool not permitted: {tool}")


class ModelClient:
    def __init__(self, spec: dict[str, Any], role: str = "model", progress: RunProgress | None = None):
        self.spec = spec
        self.role = role
        self.progress = progress

    @property
    def model(self) -> str:
        return str(self.spec["model"])

    def health(self) -> tuple[bool, str]:
        url = self.spec["base_url"].rstrip("/") + "/models"
        req = urllib.request.Request(url, headers={"Authorization": f"Bearer {self.spec.get('api_key','local')}"})
        try:
            with urllib.request.urlopen(req, timeout=5) as r:
                data = json.loads(r.read())
            ids = {str(x.get("id")) for x in data.get("data", []) if isinstance(x, dict)} if isinstance(data, dict) else set()
            wanted = self.model
            basename = wanted.rsplit("/", 1)[-1]
            if ids and wanted not in ids and basename not in ids:
                return False, f"server reachable but model not advertised; available={sorted(ids)[:12]}"
            return True, f"model advertised by {url}"
        except Exception as e:
            return False, str(e)

    def chat_json(
        self,
        system: str,
        user: str,
        *,
        operation: str = "chat",
        conn: sqlite3.Connection | None = None,
        run_id: str | None = None,
        hypothesis_id: str | None = None,
        request_overrides: dict[str, Any] | None = None,
    ) -> Any:
        url = self.spec["base_url"].rstrip("/") + "/chat/completions"
        base_body = {
            "model": self.model,
            "messages": [{"role": "system", "content": system}, {"role": "user", "content": user}],
            "temperature": self.spec.get("temperature", 0.2),
            "max_tokens": self.spec.get("max_tokens", 8192),
        }
        override = request_overrides if isinstance(request_overrides, dict) else {}
        request_body = self.spec.get("request_body", {})
        if isinstance(request_body, dict):
            base_body.update(request_body)
        override_body = override.get("request_body", {})
        if isinstance(override_body, dict):
            # Merge request bodies so stage-specific chat_template_kwargs override model defaults.
            merged_body = deep_merge(
                request_body if isinstance(request_body, dict) else {},
                override_body,
            )
            for key in list(base_body):
                if key in request_body:
                    base_body.pop(key, None)
            base_body.update(merged_body)
        if "temperature" in override:
            base_body["temperature"] = override["temperature"]
        if "max_tokens" in override:
            base_body["max_tokens"] = override["max_tokens"]
        timeout = int(override.get("timeout_seconds", self.spec.get("timeout_seconds", 600)))
        repair_attempts = max(0, int(override.get("structured_repair_attempts", self.spec.get("structured_repair_attempts", 1))))
        repair_timeout = max(15, int(override.get("structured_repair_timeout_seconds", self.spec.get("structured_repair_timeout_seconds", min(120, timeout)))))
        repair_max_tokens = max(128, int(override.get("structured_repair_max_tokens", self.spec.get("structured_repair_max_tokens", 1024))))
        repair_request_body = self.spec.get("structured_repair_request_body", {})
        if isinstance(override.get("structured_repair_request_body"), dict):
            repair_request_body = deep_merge(repair_request_body if isinstance(repair_request_body, dict) else {}, override["structured_repair_request_body"])
        total_timeout_raw = override.get("total_timeout_seconds")
        total_timeout = max(15, int(total_timeout_raw)) if total_timeout_raw is not None else None
        heartbeat = self.progress.heartbeat_seconds if self.progress else 20
        started_wall = now(); started_all = time.monotonic(); response_text = ""; error = None
        diagnostics: list[str] = []
        last_malformed_text = ""

        try:
            for attempt in range(repair_attempts + 1):
                attempt_operation = operation if attempt == 0 else f"{operation}_repair_{attempt}"
                elapsed_total = time.monotonic() - started_all
                remaining_total = None if total_timeout is None else total_timeout - elapsed_total
                if remaining_total is not None and remaining_total <= 0:
                    raise TimeoutError(f"{self.role} model request exceeded {total_timeout}s total timeout during {operation}")
                requested_attempt_timeout = timeout if attempt == 0 else min(timeout, repair_timeout)
                attempt_timeout = requested_attempt_timeout if remaining_total is None else min(requested_attempt_timeout, max(1, int(remaining_total)))
                body = json.loads(json.dumps(base_body))
                if attempt:
                    # Repair formatting, not reasoning. Re-running the entire investigation can cost minutes and
                    # can change the substantive answer. Feed only the malformed final answer plus schema hint.
                    schema_hint = structured_schema_hint(user)
                    repair_payload = {
                        "task": "Convert the malformed final answer into exactly one valid JSON value matching the supplied schema. Preserve its substantive conclusion; do not add new facts or reasoning.",
                        "schema": schema_hint,
                        "malformed_final_answer": last_malformed_text[:12000],
                    }
                    body["messages"] = [
                        {"role": "system", "content": "You are a deterministic JSON-format repairer. Do not reason about the underlying task. Return JSON only."},
                        {"role": "user", "content": json.dumps(repair_payload)},
                    ]
                    body["temperature"] = 0
                    body["max_tokens"] = repair_max_tokens
                    if isinstance(repair_request_body, dict):
                        body = deep_merge(body, repair_request_body)
                raw = json.dumps(body).encode()
                req = urllib.request.Request(
                    url, data=raw, method="POST",
                    headers={"Content-Type": "application/json", "Authorization": f"Bearer {self.spec.get('api_key','local')}"},
                )
                result_queue: queue.Queue[tuple[str, Any]] = queue.Queue(maxsize=1)

                def _request_worker() -> None:
                    try:
                        with urllib.request.urlopen(req, timeout=attempt_timeout) as r:
                            result_queue.put(("ok", json.loads(r.read())))
                    except BaseException as exc:
                        result_queue.put(("error", exc))

                if self.progress:
                    label = f"{operation} · model={self.model}" if attempt == 0 else f"{operation} · repair {attempt}/{repair_attempts} · model={self.model}"
                    self.progress.update(f"{self.role.upper()} request", label)
                attempt_started = time.monotonic()
                thread = threading.Thread(target=_request_worker, daemon=True, name=f"auditctl-{self.role}-{attempt_operation}")
                thread.start()
                while True:
                    elapsed = time.monotonic() - attempt_started
                    remaining = attempt_timeout - elapsed
                    if remaining <= 0:
                        raise TimeoutError(f"{self.role} model request exceeded {attempt_timeout}s timeout during {attempt_operation}")
                    try:
                        status, payload = result_queue.get(timeout=min(heartbeat, remaining))
                        break
                    except queue.Empty:
                        elapsed_now = time.monotonic() - attempt_started
                        if elapsed_now >= attempt_timeout:
                            raise TimeoutError(f"{self.role} model request exceeded {attempt_timeout}s timeout during {attempt_operation}")
                        if self.progress:
                            self.progress.heartbeat(f"{self.role.upper()} request still running — {int(elapsed_now)}s elapsed · {attempt_operation}")
                if status == "error":
                    raise payload
                data = payload
                try:
                    choice = data["choices"][0]
                    message = choice.get("message", {})
                except Exception as exc:
                    raise RuntimeError(f"model response missing choices[0].message during {attempt_operation}") from exc
                finish_reason = str(choice.get("finish_reason", ""))
                candidates = model_message_text_candidates(message)
                response_text = next((text for _, text in candidates if text.strip()), "")
                parse_error = None
                for field_name, candidate_text in candidates:
                    if not candidate_text.strip():
                        continue
                    try:
                        out = parse_json_payload(candidate_text)
                        if self.progress:
                            suffix = "" if attempt == 0 else f" after structured repair {attempt}"
                            source_suffix = "" if field_name == "content" else f" · parsed from {field_name}"
                            self.progress.update(f"{self.role.upper()} response", f"{operation} complete in {int(time.monotonic()-started_all)}s{suffix}{source_suffix}")
                        return out
                    except Exception as exc:
                        parse_error = exc
                content_chars = len(message_field_text(message, "content"))
                reasoning_chars = len(message_field_text(message, "reasoning_content"))
                reasoning_alt_chars = len(message_field_text(message, "reasoning"))
                diag = (
                    f"finish_reason={finish_reason or 'unknown'} content_chars={content_chars} "
                    f"reasoning_content_chars={reasoning_chars} reasoning_chars={reasoning_alt_chars}"
                )
                diagnostics.append(diag)
                # Prefer visible final content. Fall back only when the runtime produced no final content.
                visible = message_field_text(message, "content")
                if visible.strip():
                    last_malformed_text = visible
                else:
                    last_malformed_text = next((text for _, text in candidates if text.strip()), "")
                if attempt < repair_attempts:
                    if self.progress:
                        self.progress.update(
                            f"{self.role.upper()} structured repair",
                            f"{operation} returned non-JSON; retrying once · {diag}",
                        )
                    continue
                detail = "; ".join(diagnostics)
                if parse_error:
                    raise RuntimeError(f"model returned no parseable JSON during {operation} after {attempt + 1} attempt(s): {detail}; last_parse_error={parse_error}")
                raise RuntimeError(f"model returned empty structured output during {operation} after {attempt + 1} attempt(s): {detail}")
        except urllib.error.HTTPError as e:
            error = f"model HTTP {e.code}: {e.read().decode(errors='replace')[:4000]}"
            raise RuntimeError(error) from e
        except KeyboardInterrupt:
            error = "interrupted"
            raise
        except Exception as e:
            error = str(e)
            raise
        finally:
            if conn is not None:
                duration_ms = int((time.monotonic() - started_all) * 1000)
                conn.execute(
                    "INSERT INTO model_calls(id,run_id,hypothesis_id,role,operation,model,started_at,duration_ms,success,response_sha256,error) VALUES(?,?,?,?,?,?,?,?,?,?,?)",
                    (str(uuid.uuid4()), run_id, hypothesis_id, self.role, operation, self.model, started_wall, duration_ms, int(error is None), hashlib.sha256(response_text.encode()).hexdigest() if response_text else None, error),
                )
                conn.commit()


def message_field_text(message: dict[str, Any], key: str) -> str:
    value = message.get(key, "")
    if isinstance(value, str):
        return value
    if isinstance(value, list):
        parts: list[str] = []
        for item in value:
            if isinstance(item, str):
                parts.append(item)
            elif isinstance(item, dict):
                text = item.get("text") or item.get("content")
                if isinstance(text, str):
                    parts.append(text)
        return "\n".join(parts)
    if isinstance(value, dict):
        text = value.get("text") or value.get("content")
        return text if isinstance(text, str) else ""
    return ""


def model_message_text_candidates(message: dict[str, Any]) -> list[tuple[str, str]]:
    return [
        ("content", message_field_text(message, "content")),
        ("reasoning_content", message_field_text(message, "reasoning_content")),
        ("reasoning", message_field_text(message, "reasoning")),
    ]


def structured_schema_hint(user: str) -> Any:
    try:
        payload = json.loads(user)
    except Exception:
        return None
    if isinstance(payload, dict) and "schema" in payload:
        return payload.get("schema")
    return None


def parse_json_payload(text: str) -> Any:
    text = text.strip()
    if not text:
        raise ValueError("empty model output")
    if text.startswith("```"):
        text = re.sub(r"^```(?:json)?\s*", "", text)
        text = re.sub(r"\s*```$", "", text)
    try:
        return json.loads(text)
    except json.JSONDecodeError:
        starts = [i for i in (text.find("{"), text.find("[")) if i >= 0]
        if not starts:
            raise
        start = min(starts)
        for end in range(len(text), start, -1):
            try:
                return json.loads(text[start:end])
            except json.JSONDecodeError:
                pass
        raise


def compact_docs(root: pathlib.Path, broker: ToolBroker, budget: int = 120000) -> str:
    candidates = [
        "README.md", "CLAUDE.md", "AGENTS.md", "PRODUCT.md", "ARCHITECTURE.md",
        "docs/README.md", "package.json", "pyproject.toml", "Cargo.toml", "go.mod",
    ]
    chunks: list[str] = []
    budget = max(1000, int(budget)); used = 0
    for rel in candidates:
        p = root / rel
        if p.is_file() and p.stat().st_size <= broker.max_file:
            try:
                content = broker.read(rel)
            except Exception:
                continue
            chunk = f"\n===== {rel} =====\n{content}\n"
            if used + len(chunk) > budget:
                break
            chunks.append(chunk); used += len(chunk)
    return "".join(chunks)


def changed_files(root: pathlib.Path, previous_sha: str | None, current_sha: str) -> list[str]:
    if not previous_sha or previous_sha == current_sha:
        return []
    p = run_cmd(["git", "diff", "--name-only", f"{previous_sha}..{current_sha}"], root, timeout=30, check=False)
    return [x for x in p.stdout.splitlines() if x.strip()][:1000]


def operation_policy(cfg: dict[str, Any], operation: str) -> dict[str, Any]:
    policies = cfg.get("operation_policies", {})
    if not isinstance(policies, dict):
        return {}
    if operation in policies and isinstance(policies[operation], dict):
        return policies[operation]
    # Prefix families keep policy configuration compact for iterative operations.
    for prefix in ("investigate", "challenge"):
        if operation.startswith(prefix) and isinstance(policies.get(prefix), dict):
            return policies[prefix]
    return {}


def validate_intelligence(out: Any) -> dict[str, Any]:
    if not isinstance(out, dict):
        raise RuntimeError("repository intelligence output must be an object")
    required = ["product_summary", "critical_user_flows", "systems", "trust_boundaries", "critical_invariants", "risk_hotspots"]
    missing = [x for x in required if x not in out]
    if missing:
        raise RuntimeError(f"repository intelligence missing fields: {missing}")
    return out


def smoke_primary_probe(primary: ModelClient, conn: sqlite3.Connection, run_id: str) -> dict[str, Any]:
    system = """You are the primary-role protocol smoke probe. Return JSON only. This is not an audit task. Confirm that you can produce a short structured response."""
    out = primary.chat_json(
        system,
        json.dumps({"task": "Return exactly the requested smoke-probe structure.", "schema": {"status": "OK", "role": "primary"}}),
        operation="primary_smoke_probe",
        conn=conn,
        run_id=run_id,
    )
    if not isinstance(out, dict) or str(out.get("status", "")) != "OK" or str(out.get("role", "")) != "primary":
        raise RuntimeError(f"invalid primary smoke probe response: {out!r}")
    return out


def repository_intelligence(primary: ModelClient, root: pathlib.Path, broker: ToolBroker, snap: dict[str, Any], rid: str, cfg: dict[str, Any], conn: sqlite3.Connection, run_id: str) -> tuple[dict[str, Any], bool]:
    tree_budget = max(1000, int(cfg["limits"].get("max_repository_tree_bytes", 80000)))
    docs_budget = max(1000, int(cfg["limits"].get("max_bootstrap_docs_bytes", 120000)))
    tree = broker.tree()[:tree_budget]
    docs = compact_docs(root, broker, docs_budget)
    system = """You are the repository-intelligence stage of an evidence-driven audit system. Return JSON only. Do not claim defects. Build a compact operational model of the product and codebase. Distinguish documented intent from inference. Never request or imply source modification."""
    payload = {
        "task": "Build repository intelligence",
        "snapshot": {k: snap[k] for k in ("head", "branch", "dirty")},
        "tracked_files": tree,
        "key_documents": docs,
        "required_schema": {
            "product_summary": "string",
            "critical_user_flows": ["string"],
            "systems": [{"name": "string", "paths": ["string"], "purpose": "string"}],
            "trust_boundaries": ["string"],
            "critical_invariants": ["string"],
            "risk_hotspots": [{"area": "string", "reason": "string"}],
        },
    }
    user = json.dumps(payload)
    input_sha = hashlib.sha256((system + "\n" + user).encode()).hexdigest()
    row = conn.execute(
        "SELECT intelligence_json,source_run_id,created_at FROM repository_intelligence_cache "
        "WHERE repository_id=? AND head_sha=? AND primary_model=? AND input_sha256=?",
        (rid, snap["head"], primary.model, input_sha),
    ).fetchone()
    if row:
        try:
            return validate_intelligence(json.loads(row["intelligence_json"])), True
        except Exception:
            # Corrupt/stale cache entries never bypass validation.
            conn.execute(
                "DELETE FROM repository_intelligence_cache WHERE repository_id=? AND head_sha=? AND primary_model=? AND input_sha256=?",
                (rid, snap["head"], primary.model, input_sha),
            )
            conn.commit()
    out = primary.chat_json(
        system, user, operation="repository_intelligence", conn=conn, run_id=run_id,
        request_overrides=operation_policy(cfg, "repository_intelligence"),
    )
    validated = validate_intelligence(out)
    conn.execute(
        "INSERT OR REPLACE INTO repository_intelligence_cache(repository_id,head_sha,primary_model,input_sha256,intelligence_json,source_run_id,created_at) VALUES(?,?,?,?,?,?,?)",
        (rid, snap["head"], primary.model, input_sha, json.dumps(validated, sort_keys=True), run_id, now()),
    )
    conn.commit()
    return validated, False


def generate_hypotheses(primary: ModelClient, intel: dict[str, Any], coverage: list[dict[str, Any]], changes: list[str], limit: int, cfg: dict[str, Any], conn: sqlite3.Connection, run_id: str) -> list[dict[str, Any]]:
    system = """You generate audit hypotheses, not findings. Return JSON only. Each hypothesis must be falsifiable and name evidence that could prove and disprove it. Favor high-business-impact, low-coverage, recently changed, trust-boundary, concurrency, data-integrity, failure-recovery, security, observability, performance, accessibility, and customer-journey risks. Avoid style/taste suggestions and avoid duplicating hypotheses already represented in the supplied coverage/history."""
    schema = {
        "hypotheses": [{
            "subsystem": "string", "lens": "string", "title": "string", "hypothesis": "string",
            "priority": 0.0, "search_terms": ["string"], "paths": ["string"],
            "proof_needed": ["string"], "disproof_needed": ["string"]
        }]
    }
    out = primary.chat_json(
        system,
        json.dumps({"repository": intel, "coverage": coverage, "changed_files": changes, "limit": limit, "schema": schema}),
        operation="generate_hypotheses", conn=conn, run_id=run_id,
        request_overrides=operation_policy(cfg, "generate_hypotheses"),
    )
    items = out.get("hypotheses", []) if isinstance(out, dict) else []
    valid: list[dict[str, Any]] = []
    for x in items:
        if not isinstance(x, dict) or not x.get("title") or not x.get("hypothesis"):
            continue
        if not isinstance(x.get("search_terms", []), list) or not isinstance(x.get("paths", []), list):
            continue
        valid.append(x)
    return valid[:limit]


def initial_requests(hyp: dict[str, Any]) -> list[dict[str, Any]]:
    requests: list[dict[str, Any]] = []
    for term in hyp.get("search_terms", [])[:4]:
        requests.append({"tool": "search", "query": str(term), "path": "."})
    for rel in hyp.get("paths", [])[:4]:
        requests.append({"tool": "read", "path": str(rel), "start": 1, "end": 400})
    return requests


def compact_evidence_for_model(packet: list[dict[str, str]], cfg: dict[str, Any]) -> list[dict[str, str]]:
    total_budget = int(cfg["limits"].get("max_evidence_context_bytes", 180000))
    item_budget = int(cfg["limits"].get("max_evidence_item_bytes", 45000))
    selected: list[dict[str, str]] = []
    used = 0
    # Recent evidence is most likely to answer the model's latest request. Preserve order after selection.
    for item in reversed(packet):
        content = str(item.get("content", ""))
        if len(content) > item_budget:
            half = max(1, item_budget // 2)
            content = content[:half] + "\n... [evidence truncated by controller] ...\n" + content[-half:]
        rendered_cost = len(content) + len(str(item.get("source", ""))) + 64
        if selected and used + rendered_cost > total_budget:
            continue
        if not selected and rendered_cost > total_budget:
            content = content[:max(1, total_budget - 256)] + "\n... [evidence truncated by controller]"
            rendered_cost = len(content) + 128
        selected.append({"kind": str(item.get("kind", "unknown")), "source": str(item.get("source", "")), "content": content})
        used += rendered_cost
        if used >= total_budget:
            break
    selected.reverse()
    return selected


def investigation_step(primary: ModelClient, intel: dict[str, Any], hyp: dict[str, Any], evidence: list[dict[str, str]], cfg: dict[str, Any], *, round_no: int, calls_left: int, verification_names: list[str], conn: sqlite3.Connection, run_id: str, hid: str, deadline: float | None = None) -> dict[str, Any]:
    system = """You are an evidence-driven repository investigator. Return JSON only. You may request more bounded read-only evidence or finish. Never promote speculation. E0=speculation, E1=direct code evidence, E2=corroborated independent evidence, E3=executable reproduction. Architecture preference without concrete cost/risk is REJECT. Do not ask for arbitrary shell commands. You may request only search, read, git, or a named allowlisted verification command."""
    schema = {
        "state": "REQUEST_EVIDENCE|REJECT|INCONCLUSIVE|CANDIDATE",
        "reason": "string",
        "requests": [
            {"tool": "search", "query": "string", "path": "."},
            {"tool": "read", "path": "relative/path", "start": 1, "end": 200},
            {"tool": "git", "args": ["log", "-n", "20", "--", "path"]},
            {"tool": "verify", "name": "allowlisted-name"}
        ],
        "candidate": {
            "title": "string", "severity": "P0|P1|P2|P3|P4", "confidence": 0.0,
            "evidence_level": "E0|E1|E2|E3", "invariant": "string", "observed": "string",
            "expected": "string", "impact": "string", "recommendation": "string"
        }
    }
    payload = {
        "repository": intel,
        "hypothesis": hyp,
        "round": round_no,
        "remaining_tool_call_budget": calls_left,
        "allowlisted_verification_commands": verification_names,
        "evidence": compact_evidence_for_model(evidence, cfg),
        "schema": schema,
    }
    request_overrides = operation_policy(cfg, "investigate")
    if deadline is not None:
        remaining = max(1, int(deadline - time.monotonic()))
        request_overrides["total_timeout_seconds"] = remaining
        if "timeout_seconds" in request_overrides:
            request_overrides["timeout_seconds"] = min(int(request_overrides["timeout_seconds"]), remaining)
        else:
            request_overrides["timeout_seconds"] = remaining
        request_overrides["structured_repair_timeout_seconds"] = min(
            int(request_overrides.get("structured_repair_timeout_seconds", getattr(primary, "spec", {}).get("structured_repair_timeout_seconds", 90))),
            max(15, remaining // 3),
        )
    out = primary.chat_json(system, json.dumps(payload), operation=f"investigate_round_{round_no}", conn=conn, run_id=run_id, hypothesis_id=hid,
        request_overrides=request_overrides)
    if not isinstance(out, dict):
        raise RuntimeError("investigation output must be object")
    state = str(out.get("state", ""))
    if state not in {"REQUEST_EVIDENCE", "REJECT", "INCONCLUSIVE", "CANDIDATE"}:
        raise RuntimeError(f"invalid investigation state: {state!r}")
    if state == "REQUEST_EVIDENCE" and not isinstance(out.get("requests"), list):
        raise RuntimeError("REQUEST_EVIDENCE requires requests array")
    if state == "CANDIDATE" and not isinstance(out.get("candidate"), dict):
        raise RuntimeError("CANDIDATE requires candidate object")
    return out


def normalized_action_signature(requests: list[dict[str, Any]]) -> str:
    return hashlib.sha256(json.dumps(requests, sort_keys=True, separators=(",", ":")).encode()).hexdigest()


def record_tool_call(conn: sqlite3.Connection, run_id: str, hid: str, req: dict[str, Any], started_at: str, duration_ms: int, success: bool, output: str, error: str | None) -> None:
    conn.execute(
        "INSERT INTO tool_calls(id,run_id,hypothesis_id,tool,request_json,started_at,duration_ms,success,output_sha256,error) VALUES(?,?,?,?,?,?,?,?,?,?)",
        (str(uuid.uuid4()), run_id, hid, str(req.get("tool", "")), json.dumps(req, sort_keys=True), started_at, duration_ms, int(success), hashlib.sha256(output.encode()).hexdigest() if output else None, error),
    )
    conn.commit()


def execute_evidence_requests(broker: ToolBroker, requests: list[dict[str, Any]], call_budget: int, conn: sqlite3.Connection, run_id: str, hid: str) -> tuple[list[dict[str, str]], int]:
    packet: list[dict[str, str]] = []
    used = 0
    for req in requests:
        if used >= call_budget:
            break
        if not isinstance(req, dict):
            continue
        started_wall = now(); started = time.monotonic(); output = ""; error = None
        try:
            kind, source, output = broker.execute_request(req)
            packet.append({"kind": kind, "source": source, "content": output})
        except Exception as e:
            error = str(e)
            packet.append({"kind": "tool_error", "source": json.dumps(req, sort_keys=True), "content": error})
        finally:
            record_tool_call(conn, run_id, hid, req, started_wall, int((time.monotonic() - started) * 1000), error is None, output, error)
        used += 1
    return packet, used


def store_evidence(conn: sqlite3.Connection, hid: str, packet: list[dict[str, str]]) -> None:
    existing = {r[0] for r in conn.execute("SELECT sha256 FROM evidence WHERE hypothesis_id=?", (hid,)).fetchall()}
    for e in packet:
        content = e.get("content", "")
        digest = hashlib.sha256((e.get("kind", "") + "\0" + e.get("source", "") + "\0" + content).encode()).hexdigest()
        if digest in existing:
            continue
        conn.execute(
            "INSERT INTO evidence(id,hypothesis_id,kind,source,content,sha256,created_at) VALUES(?,?,?,?,?,?,?)",
            (str(uuid.uuid4()), hid, e.get("kind", "unknown"), e.get("source", ""), content, digest, now()),
        )
        existing.add(digest)
    conn.commit()


def investigate_iterative(primary: ModelClient, intel: dict[str, Any], hyp: dict[str, Any], broker: ToolBroker, cfg: dict[str, Any], conn: sqlite3.Connection, run_id: str, hid: str, deadline: float) -> tuple[dict[str, Any], list[dict[str, str]]]:
    max_calls = int(cfg["limits"]["max_tool_calls_per_investigation"])
    max_rounds = int(cfg["limits"]["max_rounds_per_investigation"])
    max_repeat = int(cfg["limits"].get("max_repeated_action_sets", 1))
    verification_names = [str(x.get("name")) for x in cfg.get("verification_commands", []) if isinstance(x, dict) and x.get("name")]
    seed_requests = initial_requests(hyp)[:min(max_calls, 6)]
    packet, used = execute_evidence_requests(broker, seed_requests, min(max_calls, 6), conn, run_id, hid)
    store_evidence(conn, hid, packet)
    seen_actions: dict[str, int] = {}
    previous_response_sig: str | None = None

    for round_no in range(1, max_rounds + 1):
        if time.monotonic() >= deadline:
            return {"state": "INCONCLUSIVE", "reason": "investigation deadline reached"}, packet
        try:
            out = investigation_step(primary, intel, hyp, packet, cfg, round_no=round_no, calls_left=max(0, max_calls-used), verification_names=verification_names, conn=conn, run_id=run_id, hid=hid, deadline=deadline)
        except TimeoutError as exc:
            return {"state": "INCONCLUSIVE", "reason": f"investigation model deadline reached: {exc}"}, packet
        except RuntimeError as exc:
            text = str(exc)
            if "parseable JSON" in text or "structured output" in text or "invalid investigation" in text:
                return {"state": "INCONCLUSIVE", "reason": f"investigation structured-output failure: {text}"}, packet
            raise
        response_sig = hashlib.sha256(json.dumps(out, sort_keys=True, default=str).encode()).hexdigest()
        if response_sig == previous_response_sig:
            return {"state": "INCONCLUSIVE", "reason": "model repeated an identical investigation response"}, packet
        previous_response_sig = response_sig
        state = str(out["state"])
        if state != "REQUEST_EVIDENCE":
            return out, packet
        requests = [x for x in out.get("requests", []) if isinstance(x, dict)]
        if not requests:
            return {"state": "INCONCLUSIVE", "reason": "model requested evidence without any requests"}, packet
        sig = normalized_action_signature(requests)
        seen_actions[sig] = seen_actions.get(sig, 0) + 1
        if seen_actions[sig] > max_repeat:
            return {"state": "INCONCLUSIVE", "reason": "repeated evidence-request loop detected"}, packet
        left = max_calls - used
        if left <= 0:
            return {"state": "INCONCLUSIVE", "reason": "tool-call budget exhausted"}, packet
        new_packet, consumed = execute_evidence_requests(broker, requests, left, conn, run_id, hid)
        used += consumed
        store_evidence(conn, hid, new_packet)
        before = {(x["kind"], x["source"], hashlib.sha256(x["content"].encode()).hexdigest()) for x in packet}
        novel = [x for x in new_packet if (x["kind"], x["source"], hashlib.sha256(x["content"].encode()).hexdigest()) not in before]
        packet.extend(novel)
        if not novel:
            return {"state": "INCONCLUSIVE", "reason": "evidence requests produced no new information"}, packet
    return {"state": "INCONCLUSIVE", "reason": "maximum investigation rounds reached"}, packet


def challenge(challenger: ModelClient, candidate: dict[str, Any], hyp: dict[str, Any], evidence: list[dict[str, str]], cfg: dict[str, Any], conn: sqlite3.Connection, run_id: str, hid: str) -> dict[str, Any]:
    system = """You are the independent adversarial challenger. Return JSON only. Your job is to falsify the candidate finding. Look for guards, impossible paths, mistaken assumptions, contradicting code/tests/contracts, inflated impact/severity, and insufficient evidence. Return CONFIRM, REJECT, or INCONCLUSIVE. Do not agree merely because a primary model proposed it. Never suggest source modifications beyond a remediation direction."""
    schema = {"verdict": "CONFIRM|REJECT|INCONCLUSIVE", "reason": "string", "adjusted_severity": "P0|P1|P2|P3|P4|null", "adjusted_confidence": "number|null"}
    out = challenger.chat_json(system, json.dumps({"hypothesis": hyp, "candidate": candidate, "evidence": compact_evidence_for_model(evidence, cfg), "schema": schema}), operation="challenge", conn=conn, run_id=run_id, hypothesis_id=hid,
        request_overrides=operation_policy(cfg, "challenge"))
    if not isinstance(out, dict):
        raise RuntimeError("challenge output must be object")
    verdict = str(out.get("verdict", ""))
    if verdict not in {"CONFIRM", "REJECT", "INCONCLUSIVE"}:
        raise RuntimeError(f"invalid challenger verdict: {verdict!r}")
    return out


def smoke_challenger_probe(challenger: ModelClient, conn: sqlite3.Connection, run_id: str) -> dict[str, Any]:
    system = """You are the challenger-role protocol smoke probe. Return JSON only. This is not an audit finding and must not create one. Confirm that you can follow the challenger role and structured-output contract."""
    schema = {"status": "OK", "role": "challenger", "reason": "short string"}
    out = challenger.chat_json(system, json.dumps({"task": "Return the smoke-probe schema exactly enough for validation.", "schema": schema}), operation="challenger_smoke_probe", conn=conn, run_id=run_id)
    if not isinstance(out, dict):
        raise RuntimeError("challenger smoke probe output must be object")
    if str(out.get("status", "")) != "OK" or str(out.get("role", "")) != "challenger":
        raise RuntimeError(f"invalid challenger smoke probe response: {out!r}")
    return out


def fingerprint(title: str, subsystem: str, invariant: str, observed: str) -> str:
    basis = "|".join(x.strip().lower() for x in (title, subsystem, invariant, observed))
    basis = re.sub(r"\s+", " ", basis)
    return hashlib.sha256(basis.encode()).hexdigest()[:32]


def coverage_rows(conn: sqlite3.Connection, rid: str) -> list[dict[str, Any]]:
    return [dict(x) for x in conn.execute("SELECT subsystem,lens,score,investigations FROM coverage WHERE repository_id=? ORDER BY score ASC", (rid,)).fetchall()]


def bump_coverage(conn: sqlite3.Connection, rid: str, run_id: str, subsystem: str, lens: str) -> None:
    ts = now()
    row = conn.execute("SELECT score,investigations FROM coverage WHERE repository_id=? AND subsystem=? AND lens=?", (rid, subsystem, lens)).fetchone()
    if row:
        inv = int(row[1]) + 1
        score = min(0.98, float(row[0]) + (0.12 * (1 - float(row[0]))))
        conn.execute("UPDATE coverage SET score=?,investigations=?,last_run_id=?,updated_at=? WHERE repository_id=? AND subsystem=? AND lens=?", (score, inv, run_id, ts, rid, subsystem, lens))
    else:
        conn.execute("INSERT INTO coverage(repository_id,subsystem,lens,score,investigations,last_run_id,updated_at) VALUES(?,?,?,?,?,?,?)", (rid, subsystem, lens, 0.12, 1, run_id, ts))
    conn.commit()


def accepted(candidate: dict[str, Any], challenge_out: dict[str, Any]) -> bool:
    sev = str(candidate.get("severity", "P4"))
    ev = str(candidate.get("evidence_level", "E0"))
    try:
        conf = float(candidate.get("confidence", 0) or 0)
    except (TypeError, ValueError):
        return False
    ch = str(challenge_out.get("verdict", "INCONCLUSIVE"))
    if sev not in {"P0", "P1", "P2", "P3", "P4"} or ev not in {"E0", "E1", "E2", "E3"}:
        return False
    if sev == "P4" or ev == "E0" or ch == "REJECT":
        return False
    if ev in ("E2", "E3") and conf >= 0.60 and ch in ("CONFIRM", "INCONCLUSIVE"):
        return True
    if ev == "E1" and sev in ("P0", "P1") and conf >= 0.75 and ch == "CONFIRM":
        return True
    return False


def write_report(conn: sqlite3.Connection, run_id: str, root: pathlib.Path) -> pathlib.Path:
    run = conn.execute("SELECT * FROM runs WHERE id=?", (run_id,)).fetchone()
    findings = conn.execute("SELECT * FROM findings WHERE run_id=? AND status='ACCEPTED' ORDER BY CASE severity WHEN 'P0' THEN 0 WHEN 'P1' THEN 1 WHEN 'P2' THEN 2 WHEN 'P3' THEN 3 ELSE 4 END, confidence DESC", (run_id,)).fetchall()
    rej = conn.execute("SELECT COUNT(*) FROM rejections WHERE run_id=?", (run_id,)).fetchone()[0]
    inc = conn.execute("SELECT COUNT(*) FROM hypotheses WHERE run_id=? AND status='INCONCLUSIVE'", (run_id,)).fetchone()[0]
    total = conn.execute("SELECT COUNT(*) FROM hypotheses WHERE run_id=?", (run_id,)).fetchone()[0]
    mcalls = conn.execute("SELECT COUNT(*), COALESCE(SUM(duration_ms),0), COALESCE(SUM(CASE WHEN success=0 THEN 1 ELSE 0 END),0) FROM model_calls WHERE run_id=?", (run_id,)).fetchone()
    tcalls = conn.execute("SELECT COUNT(*), COALESCE(SUM(duration_ms),0), COALESCE(SUM(CASE WHEN success=0 THEN 1 ELSE 0 END),0) FROM tool_calls WHERE run_id=?", (run_id,)).fetchone()
    lines = [
        "# Overnight Audit Report", "", f"- Repository: `{root}`", f"- SHA: `{run['head_sha']}`",
        f"- Branch: `{run['branch']}`", f"- Started: {run['started_at']}", f"- Status: {run['status']}",
        f"- Primary: `{run['primary_model']}`", f"- Challenger: `{run['challenger_model']}`", "",
        "## Summary", "", f"- Actionable findings: **{len(findings)}**", f"- Hypotheses investigated/created: **{total}**",
        f"- Rejected: **{rej}**", f"- Inconclusive: **{inc}**",
        f"- Model calls: **{mcalls[0]}** ({mcalls[1]/1000:.1f}s total; failures {mcalls[2]})",
        f"- Brokered tool calls: **{tcalls[0]}** ({tcalls[1]/1000:.1f}s total; failures {tcalls[2]})", "",
    ]
    if findings:
        lines += ["## Actionable findings", ""]
        for i, f in enumerate(findings, 1):
            lines += [
                f"### {i}. {f['title']}", "",
                f"- Severity: **{f['severity']}**", f"- Confidence: **{float(f['confidence']):.0%}**",
                f"- Evidence: **{f['evidence_level']}**", f"- Subsystem: `{f['subsystem'] or 'unknown'}`",
                f"- Lens: `{f['lens'] or 'unknown'}`", f"- Challenger: **{f['challenger_verdict']}**", "",
                f"**Invariant:** {f['invariant'] or 'n/a'}", "", f"**Observed:** {f['observed']}", "",
                f"**Expected:** {f['expected'] or 'n/a'}", "", f"**Impact:** {f['impact'] or 'n/a'}", "",
                f"**Recommended direction:** {f['recommendation'] or 'n/a'}", "",
                f"**Challenger rationale:** {f['challenger_reason'] or 'n/a'}", "",
            ]
    else:
        lines += ["## Actionable findings", "", "No finding passed the evidence and challenger gates in this run.", ""]
    lines += ["## Interpretation", "", "A low finding count is not a failed run. Rejected and inconclusive hypotheses are retained to reduce repeated work in later nights. Model/tool telemetry is included so runtime instability is visible rather than hidden.", ""]
    path = REPORT_DIR / f"{root.name}-{run_id[:8]}.md"
    path.write_text("\n".join(lines) + "\n")
    return path


def effective_cfg(cfg: dict[str, Any], profile: str, requested_hours: float | None) -> tuple[dict[str, Any], float]:
    out = deep_merge(DEFAULT_CONFIG, cfg)
    if profile in {"smoke", "validation"}:
        key_name = "smoke_profile" if profile == "smoke" else "validation_profile"
        vp = out.get(key_name, {})
        for key in (
            "max_hypotheses_per_batch", "max_rounds_per_investigation",
            "max_tool_calls_per_investigation", "max_investigation_minutes", "max_repository_tree_bytes",
            "max_bootstrap_docs_bytes", "max_evidence_context_bytes",
            "max_evidence_item_bytes", "report_reserve_minutes",
            "challenge_reserve_minutes",
        ):
            if key in vp:
                out["limits"][key] = vp[key]
        if "max_investigations" in vp:
            out["limits"]["max_investigations_per_run"] = vp["max_investigations"]
        if "primary_timeout_seconds" in vp:
            out["primary"]["timeout_seconds"] = vp["primary_timeout_seconds"]
        if "challenger_timeout_seconds" in vp:
            out["challenger"]["timeout_seconds"] = vp["challenger_timeout_seconds"]
        if "primary_max_tokens" in vp:
            out["primary"]["max_tokens"] = vp["primary_max_tokens"]
        if "challenger_max_tokens" in vp:
            out["challenger"]["max_tokens"] = vp["challenger_max_tokens"]
        if "primary_structured_repair_timeout_seconds" in vp:
            out["primary"]["structured_repair_timeout_seconds"] = vp["primary_structured_repair_timeout_seconds"]
        if "challenger_structured_repair_timeout_seconds" in vp:
            out["challenger"]["structured_repair_timeout_seconds"] = vp["challenger_structured_repair_timeout_seconds"]
        if isinstance(vp.get("primary_request_body"), dict):
            out["primary"]["request_body"] = deep_merge(out["primary"].get("request_body", {}), vp["primary_request_body"])
        if isinstance(vp.get("challenger_request_body"), dict):
            out["challenger"]["request_body"] = deep_merge(out["challenger"].get("request_body", {}), vp["challenger_request_body"])
        if isinstance(vp.get("operation_policies"), dict):
            out["operation_policies"] = deep_merge(out.get("operation_policies", {}), vp["operation_policies"])
        default_hours = 0.25 if profile == "smoke" else 0.5
        hours = float(requested_hours if requested_hours is not None else vp.get("hours", default_hours))
    else:
        hours = float(requested_hours if requested_hours is not None else 8.0)
    if hours <= 0:
        raise ValueError("hours must be > 0")
    return out, hours


def cmd_doctor(args: argparse.Namespace) -> int:
    cfg = load_config()
    print(f"auditctl {VERSION}")
    print(f"config: {CONFIG_PATH}")
    print(f"database: {DB_PATH}")
    for exe in ("git", "rg"):
        p = subprocess.run(["/usr/bin/env", "which", exe], text=True, capture_output=True)
        print(f"{exe}: {'OK ' + p.stdout.strip() if p.returncode == 0 else 'MISSING'}")
    failed = False
    for role in ("primary", "challenger"):
        c = ModelClient(cfg[role], role=role); ok, detail = c.health(); failed = failed or not ok
        print(f"{role}: {'OK' if ok else 'UNAVAILABLE'} model={c.model} endpoint={cfg[role]['base_url']} ({detail})")
    return 1 if failed else 0


def cmd_init(args: argparse.Namespace) -> int:
    root = git_root(pathlib.Path(args.path)); snap = snapshot(root); conn = db(); rid = upsert_repo(conn, snap)
    print(f"initialized repository {rid}: {root}")
    print(f"HEAD {snap['head']} branch={snap['branch']} dirty={snap['dirty']}")
    return 0


def cmd_status(args: argparse.Namespace) -> int:
    root = git_root(pathlib.Path(args.path)); rid = repo_id(root); conn = db()
    row = conn.execute("SELECT * FROM runs WHERE repository_id=? ORDER BY started_at DESC LIMIT 1", (rid,)).fetchone()
    if not row:
        print("no audit runs found"); return 1
    out = dict(row)
    activity = conn.execute("SELECT stage,detail,pid,updated_at FROM run_activity WHERE run_id=?", (row["id"],)).fetchone()
    if activity:
        out["active_stage"] = activity["stage"]
        out["active_detail"] = activity["detail"]
        out["pid"] = activity["pid"]
        out["activity_updated_at"] = activity["updated_at"]
    out["hypotheses"] = conn.execute("SELECT COUNT(*) FROM hypotheses WHERE run_id=?", (row["id"],)).fetchone()[0]
    out["model_calls"] = conn.execute("SELECT COUNT(*) FROM model_calls WHERE run_id=?", (row["id"],)).fetchone()[0]
    out["tool_calls"] = conn.execute("SELECT COUNT(*) FROM tool_calls WHERE run_id=?", (row["id"],)).fetchone()[0]
    print(json.dumps(out, indent=2))
    return 0


def cmd_report(args: argparse.Namespace) -> int:
    root = git_root(pathlib.Path(args.path)); rid = repo_id(root); conn = db()
    row = conn.execute("SELECT id FROM runs WHERE repository_id=? ORDER BY started_at DESC LIMIT 1", (rid,)).fetchone()
    if not row:
        print("no audit runs found"); return 1
    path = write_report(conn, row[0], root); print(path); return 0


def cmd_run(args: argparse.Namespace) -> int:
    cfg0 = load_config(); cfg, hours = effective_cfg(cfg0, args.profile, args.hours)
    root = git_root(pathlib.Path(args.path)); snap = snapshot(root)
    if snap["dirty"] and not args.allow_dirty:
        raise RuntimeError("repository has uncommitted changes; commit/stash them or pass --allow-dirty to explicitly audit a non-reproducible working tree")
    conn = db(); rid = upsert_repo(conn, snap)
    active = conn.execute("SELECT id,started_at FROM runs WHERE repository_id=? AND status='RUNNING' ORDER BY started_at DESC LIMIT 1", (rid,)).fetchone()
    if active:
        raise RuntimeError(f"repository already has a RUNNING audit ({active['id']}, started {active['started_at']}); inspect it with 'auditctl status .' and interrupt that process before starting another run")
    prev = previous_audited_sha(conn, rid)
    run_id = str(uuid.uuid4()); started = now()
    conn.execute(
        "INSERT INTO runs(id,repository_id,started_at,requested_hours,status,branch,head_sha,remote_head_sha,dirty,previous_audited_sha,primary_model,challenger_model) VALUES(?,?,?,?,?,?,?,?,?,?,?,?)",
        (run_id, rid, started, hours, "RUNNING", snap["branch"], snap["head"], snap["remote_head"], int(snap["dirty"]), prev, str(cfg["primary"]["model"]), str(cfg["challenger"]["model"])),
    ); conn.commit()
    progress = RunProgress(conn, run_id, int(cfg.get("progress", {}).get("heartbeat_seconds", 20)))
    primary = ModelClient(cfg["primary"], role="primary", progress=progress)
    challenger_client = ModelClient(cfg["challenger"], role="challenger", progress=progress)
    progress.update("Run started", f"profile={args.profile} · repository={root}")
    progress.update("Repository pinned", f"HEAD={snap['head'][:12]} · branch={snap['branch']} · dirty={snap['dirty']}")
    deadline = time.monotonic() + hours * 3600
    report_reserve = min(int(cfg["limits"]["report_reserve_minutes"]) * 60, max(30, int(hours*3600*0.2)))
    challenge_reserve = min(int(cfg["limits"]["challenge_reserve_minutes"]) * 60, max(60, int(hours*3600*0.4)))
    primary_cutoff = deadline - report_reserve - challenge_reserve
    challenge_cutoff = deadline - report_reserve
    if primary_cutoff <= time.monotonic():
        primary_cutoff = time.monotonic() + max(60, int(hours*3600*0.35))
        challenge_cutoff = deadline - max(30, report_reserve)
    broker = ToolBroker(root, cfg)
    pending: list[dict[str, Any]] = []
    try:
        progress.update("Preflight", "checking primary model endpoint")
        ok, detail = primary.health()
        if not ok: raise RuntimeError(f"primary endpoint unavailable: {detail}")
        progress.update("Preflight", "primary model endpoint OK; checking challenger")
        ok, detail = challenger_client.health()
        if not ok: raise RuntimeError(f"challenger endpoint unavailable: {detail}")
        progress.update("Preflight", "both model endpoints OK")

        if args.profile == "smoke":
            progress.update("Primary smoke probe", "testing short structured response before repository context")
            smoke_primary_probe(primary, conn, run_id)
            progress.update("Primary smoke probe", "structured primary response OK")

        progress.update("Repository intelligence", "building product/system model")
        intel, intel_cached = repository_intelligence(primary, root, broker, snap, rid, cfg, conn, run_id)
        progress.update("Repository intelligence", "cache hit" if intel_cached else "complete and cached")
        changes = changed_files(root, prev, snap["head"])
        max_total = int(cfg["limits"]["max_investigations_per_run"])
        batch = int(cfg["limits"]["max_hypotheses_per_batch"])
        created = 0
        while created < max_total and time.monotonic() < primary_cutoff:
            cov = coverage_rows(conn, rid)
            progress.update("Hypothesis generation", f"requesting up to {min(batch, max_total-created)} hypotheses")
            try:
                hyps = generate_hypotheses(primary, intel, cov, changes, min(batch, max_total-created), cfg, conn, run_id)
            except (TimeoutError, RuntimeError) as exc:
                progress.update("Hypothesis generation", f"stopped without new hypotheses · {exc}")
                break
            progress.update("Hypothesis generation", f"received {len(hyps)} hypotheses")
            if not hyps: break
            for hyp in hyps:
                if created >= max_total or time.monotonic() >= primary_cutoff: break
                hid = str(uuid.uuid4()); created += 1
                subsystem = str(hyp.get("subsystem", "unknown")); lens = str(hyp.get("lens", "unknown"))
                try: priority = float(hyp.get("priority", 0) or 0)
                except (TypeError, ValueError): priority = 0.0
                conn.execute("INSERT INTO hypotheses(id,run_id,subsystem,lens,title,hypothesis,priority,status,created_at) VALUES(?,?,?,?,?,?,?,?,?)",
                             (hid, run_id, subsystem, lens, str(hyp["title"]), str(hyp["hypothesis"]), priority, "INVESTIGATING", now())); conn.commit()
                progress.update("Investigation", f"{created}/{max_total} · {hyp['title']}")
                max_investigation_seconds = max(60, int(float(cfg["limits"].get("max_investigation_minutes", 30)) * 60))
                investigation_deadline = min(primary_cutoff, time.monotonic() + max_investigation_seconds)
                result, packet = investigate_iterative(primary, intel, hyp, broker, cfg, conn, run_id, hid, investigation_deadline)
                progress.update("Investigation", f"{created}/{max_total} · result={result.get('state','INCONCLUSIVE')}")
                state = str(result.get("state", "INCONCLUSIVE"))
                if state == "REJECT":
                    conn.execute("INSERT INTO rejections(id,run_id,hypothesis_id,reason,created_at) VALUES(?,?,?,?,?)", (str(uuid.uuid4()), run_id, hid, str(result.get("reason", "rejected")), now()))
                    conn.execute("UPDATE hypotheses SET status='REJECTED',completed_at=? WHERE id=?", (now(), hid)); conn.commit(); bump_coverage(conn, rid, run_id, subsystem, lens); continue
                if state != "CANDIDATE" or not isinstance(result.get("candidate"), dict):
                    conn.execute("UPDATE hypotheses SET status='INCONCLUSIVE',completed_at=? WHERE id=?", (now(), hid)); conn.commit(); bump_coverage(conn, rid, run_id, subsystem, lens); continue
                conn.execute("UPDATE hypotheses SET status='AWAITING_CHALLENGE' WHERE id=?", (hid,)); conn.commit()
                pending.append({"hid": hid, "subsystem": subsystem, "lens": lens, "hyp": hyp, "packet": packet, "candidate": result["candidate"]})
                bump_coverage(conn, rid, run_id, subsystem, lens)
            if len(hyps) < batch: break

        if pending:
            progress.update("Challenger phase", f"switching to challenger for {len(pending)} candidate(s)")
        elif args.profile == "smoke":
            progress.update("Challenger smoke probe", "no candidate reached challenge; exercising challenger protocol directly")
            smoke_challenger_probe(challenger_client, conn, run_id)
            progress.update("Challenger smoke probe", "structured challenger response OK")
        else:
            progress.update("Challenger phase", "no candidates require challenge")
        for challenge_index, item in enumerate(pending, start=1):
            hid = item["hid"]
            if time.monotonic() >= challenge_cutoff:
                conn.execute("UPDATE hypotheses SET status='INCONCLUSIVE',completed_at=? WHERE id=?", (now(), hid)); conn.commit(); continue
            cand = item["candidate"]
            progress.update("Challenger phase", f"{challenge_index}/{len(pending)} · {cand.get('title', item['hyp']['title'])}")
            try:
                ch = challenge(challenger_client, cand, item["hyp"], item["packet"], cfg, conn, run_id, hid)
            except (TimeoutError, RuntimeError) as exc:
                progress.update("Challenger phase", f"{challenge_index}/{len(pending)} · inconclusive due to challenger failure · {exc}")
                conn.execute("UPDATE hypotheses SET status='INCONCLUSIVE',completed_at=? WHERE id=?", (now(), hid)); conn.commit()
                continue
            progress.update("Challenger phase", f"{challenge_index}/{len(pending)} · verdict={ch.get('verdict','INCONCLUSIVE')}")
            if accepted(cand, ch):
                sev = str(ch.get("adjusted_severity") or cand.get("severity", "P3"))
                try: conf = float(ch.get("adjusted_confidence") if ch.get("adjusted_confidence") is not None else cand.get("confidence", 0))
                except (TypeError, ValueError): conf = 0.0
                fp = fingerprint(str(cand.get("title", item["hyp"]["title"])), item["subsystem"], str(cand.get("invariant", "")), str(cand.get("observed", "")))
                old = conn.execute("SELECT id FROM findings WHERE fingerprint=? ORDER BY first_seen_at ASC LIMIT 1", (fp,)).fetchone()
                status = "DUPLICATE" if old else "ACCEPTED"
                conn.execute("INSERT INTO findings(id,run_id,hypothesis_id,fingerprint,title,subsystem,lens,severity,confidence,evidence_level,invariant,observed,expected,impact,recommendation,challenger_verdict,challenger_reason,status,first_seen_at,last_seen_at) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
                             (str(uuid.uuid4()), run_id, hid, fp, str(cand.get("title", item["hyp"]["title"])), item["subsystem"], item["lens"], sev, conf, str(cand.get("evidence_level", "E0")), str(cand.get("invariant", "")), str(cand.get("observed", "")), str(cand.get("expected", "")), str(cand.get("impact", "")), str(cand.get("recommendation", "")), str(ch.get("verdict", "INCONCLUSIVE")), str(ch.get("reason", "")), status, now(), now()))
                conn.execute("UPDATE hypotheses SET status=?,completed_at=? WHERE id=?", ("CONFIRMED" if status == "ACCEPTED" else "DUPLICATE", now(), hid)); conn.commit()
            else:
                reason = f"challenger={ch.get('verdict','INCONCLUSIVE')}: {ch.get('reason','')}"
                if str(ch.get("verdict", "INCONCLUSIVE")) == "INCONCLUSIVE":
                    conn.execute("UPDATE hypotheses SET status='INCONCLUSIVE',completed_at=? WHERE id=?", (now(), hid)); conn.commit()
                else:
                    conn.execute("INSERT INTO rejections(id,run_id,hypothesis_id,reason,created_at) VALUES(?,?,?,?,?)", (str(uuid.uuid4()), run_id, hid, reason, now()))
                    conn.execute("UPDATE hypotheses SET status='REJECTED',completed_at=? WHERE id=?", (now(), hid)); conn.commit()

        progress.update("Reporting", "writing morning report")
        conn.execute("UPDATE runs SET status='COMPLETED',finished_at=? WHERE id=?", (now(), run_id)); conn.commit()
        report = write_report(conn, run_id, root)
        progress.update("Completed", f"run={run_id}")
        print(f"audit completed: {run_id}")
        print(f"report: {report}")
        return 0
    except KeyboardInterrupt:
        progress.update("Interrupted", "user interrupted run")
        conn.execute("UPDATE runs SET status='INTERRUPTED',finished_at=?,error=? WHERE id=?", (now(), "interrupted", run_id)); conn.commit()
        print("audit interrupted", file=sys.stderr); return 130
    except Exception as e:
        progress.update("Failed", str(e))
        conn.execute("UPDATE runs SET status='FAILED',finished_at=?,error=? WHERE id=?", (now(), str(e), run_id)); conn.commit()
        try:
            report = write_report(conn, run_id, root); print(f"partial report: {report}", file=sys.stderr)
        except Exception:
            pass
        print(f"audit failed: {e}", file=sys.stderr); return 1


def parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="auditctl", description="Evidence-driven overnight repository auditor")
    p.add_argument("--version", action="version", version=VERSION)
    sub = p.add_subparsers(dest="cmd", required=True)
    d = sub.add_parser("doctor"); d.set_defaults(func=cmd_doctor)
    i = sub.add_parser("init"); i.add_argument("path", nargs="?", default="."); i.set_defaults(func=cmd_init)
    r = sub.add_parser("run"); r.add_argument("path", nargs="?", default="."); r.add_argument("--hours", type=float, default=None); r.add_argument("--profile", choices=("smoke", "validation", "overnight"), default="overnight"); r.add_argument("--allow-dirty", action="store_true"); r.set_defaults(func=cmd_run)
    s = sub.add_parser("status"); s.add_argument("path", nargs="?", default="."); s.set_defaults(func=cmd_status)
    q = sub.add_parser("report"); q.add_argument("path", nargs="?", default="."); q.set_defaults(func=cmd_report)
    return p


def main() -> int:
    args = parser().parse_args()
    return int(args.func(args))


if __name__ == "__main__":
    raise SystemExit(main())
