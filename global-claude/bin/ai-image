#!/usr/bin/env python3
"""Stable local-first image generation wrapper for Apple Silicon/MFLUX.

The wrapper owns routing, policy injection, deterministic attempt naming,
technical retries, evidence metadata, edit/upscale orchestration, byte-exact
promotion of an accepted candidate to its delivery path, and a stable
JSON/exit-code contract. Visual quality judgment remains the caller's job.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import secrets
import shutil
import signal
import struct
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

VERSION = "2026.08.14-ai-image-v2.1"
SCHEMA_VERSIONS = {1, 2}
ROLES = (
    "editorial",
    "photorealistic",
    "conceptual",
    "precision",
    "fast-draft",
    "typography",
    "editing",
    "upscale",
)
GENERATION_ROLES = tuple(r for r in ROLES if r not in {"editing", "upscale"})
QUALITIES = ("draft", "standard", "high")
EXIT_CONFIG = 3
EXIT_RUNTIME = 4
EXIT_PROCESS = 5


class AiImageError(Exception):
    def __init__(self, code: str, message: str, exit_code: int = EXIT_RUNTIME, details: dict[str, Any] | None = None):
        super().__init__(message)
        self.code = code
        self.message = message
        self.exit_code = exit_code
        self.details = details or {}


def utc_now() -> str:
    return datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")


def sha256_text(value: str) -> str:
    return hashlib.sha256(value.encode("utf-8")).hexdigest()


def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def deep_merge(base: dict[str, Any], override: dict[str, Any]) -> dict[str, Any]:
    result = dict(base)
    for key, value in override.items():
        if isinstance(value, dict) and isinstance(result.get(key), dict):
            result[key] = deep_merge(result[key], value)
        else:
            result[key] = value
    return result


def config_dir() -> Path:
    raw = os.environ.get("AI_IMAGE_CONFIG_DIR")
    if raw:
        return Path(raw).expanduser().resolve()
    return (Path.home() / ".config" / "ai-image").resolve()


def load_json(path: Path, required: bool) -> dict[str, Any]:
    if not path.exists():
        if required:
            raise AiImageError("CONFIG_MISSING", f"Required configuration file is missing: {path}", EXIT_CONFIG)
        return {}
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise AiImageError("CONFIG_INVALID", f"Invalid configuration file {path}: {exc}", EXIT_CONFIG) from exc
    if not isinstance(value, dict):
        raise AiImageError("CONFIG_INVALID", f"Configuration root must be an object: {path}", EXIT_CONFIG)
    return value


def load_config() -> tuple[dict[str, Any], Path]:
    root = config_dir()
    cfg = load_json(root / "defaults.json", True)
    cfg = deep_merge(cfg, load_json(root / "models.json", True))
    cfg = deep_merge(cfg, load_json(root / "local.json", False))
    schema = cfg.get("schema_version")
    if schema not in SCHEMA_VERSIONS:
        raise AiImageError("CONFIG_SCHEMA_UNSUPPORTED", f"Unsupported ai-image schema_version: {schema}", EXIT_CONFIG)
    return cfg, root


def safe_emit(payload: dict[str, Any], as_json: bool) -> None:
    if as_json:
        print(json.dumps(payload, indent=2, sort_keys=True))
        return
    if payload.get("status") == "error":
        print(f"ERROR [{payload.get('code')}]: {payload.get('message')}")
        if payload.get("details"):
            print(f"details: {json.dumps(payload['details'], sort_keys=True)}")
        return
    for key, value in payload.items():
        if isinstance(value, (dict, list)):
            print(f"{key}: {json.dumps(value, sort_keys=True)}")
        else:
            print(f"{key}: {value}")


def role_config(cfg: dict[str, Any], role: str) -> dict[str, Any]:
    roles = cfg.get("roles")
    if not isinstance(roles, dict) or not isinstance(roles.get(role), dict):
        raise AiImageError("ROLE_NOT_CONFIGURED", f"No configuration exists for role: {role}", EXIT_CONFIG)
    return roles[role]


def policy_config(cfg: dict[str, Any], role: dict[str, Any]) -> tuple[str, dict[str, Any]]:
    policy_name = str(role.get("policy") or "")
    if not policy_name:
        return "", {}
    policies = cfg.get("policies")
    policy = policies.get(policy_name) if isinstance(policies, dict) else None
    if not isinstance(policy, dict):
        raise AiImageError("POLICY_NOT_CONFIGURED", f"Policy is not configured: {policy_name}", EXIT_CONFIG)
    return policy_name, policy


def backend_config(cfg: dict[str, Any], role: dict[str, Any]) -> tuple[str, dict[str, Any]]:
    backend_name = str(role.get("backend") or "")
    if not backend_name:
        raise AiImageError("BACKEND_NOT_CONFIGURED", "Selected role has no backend", EXIT_CONFIG)
    backends = cfg.get("backends")
    backend = backends.get(backend_name) if isinstance(backends, dict) else None
    if not isinstance(backend, dict):
        raise AiImageError("BACKEND_NOT_CONFIGURED", f"Backend is not configured: {backend_name}", EXIT_CONFIG)
    return backend_name, backend


def resolve_executable(executable: str) -> str | None:
    if not executable:
        return None
    p = Path(executable).expanduser()
    if p.is_absolute():
        return str(p) if p.is_file() and os.access(p, os.X_OK) else None
    return shutil.which(executable)


def dimensions(cfg: dict[str, Any], aspect: str, quality: str) -> tuple[int, int]:
    aspects = cfg.get("aspects")
    item = aspects.get(aspect) if isinstance(aspects, dict) else None
    dims = item.get(quality) if isinstance(item, dict) else None
    if not (isinstance(dims, list) and len(dims) == 2 and all(isinstance(x, int) and x > 0 for x in dims)):
        raise AiImageError("UNSUPPORTED_ASPECT", f"Unsupported aspect/quality combination: {aspect} / {quality}", EXIT_CONFIG)
    return int(dims[0]), int(dims[1])


def format_argv(template: list[Any], mapping: dict[str, Any]) -> list[str]:
    """Render argv template without a shell; exact list placeholders expand safely."""
    if not template:
        raise AiImageError("BACKEND_COMMAND_NOT_CONFIGURED", "Backend command template is not configured", EXIT_CONFIG)
    argv: list[str] = []
    for token in template:
        if not isinstance(token, str):
            raise AiImageError("BACKEND_COMMAND_INVALID", "Backend argument templates must contain strings only", EXIT_CONFIG)
        exact = re.fullmatch(r"\{([A-Za-z_][A-Za-z0-9_]*)\}", token)
        if exact:
            key = exact.group(1)
            if key not in mapping:
                raise AiImageError("BACKEND_TEMPLATE_PLACEHOLDER_UNKNOWN", f"Unknown backend placeholder: {key}", EXIT_CONFIG)
            value = mapping[key]
            if isinstance(value, list):
                if not all(isinstance(item, (str, int, float, bool)) for item in value):
                    raise AiImageError("BACKEND_TEMPLATE_LIST_INVALID", f"List placeholder {key} contains unsupported values", EXIT_CONFIG)
                argv.extend(str(item) for item in value)
                continue
        try:
            rendered = token.format_map(mapping)
        except KeyError as exc:
            raise AiImageError("BACKEND_TEMPLATE_PLACEHOLDER_UNKNOWN", f"Unknown backend placeholder: {exc.args[0]}", EXIT_CONFIG) from exc
        argv.append(str(rendered))
    return argv


def bounded_output(text: str | None, limit: int = 32768) -> str:
    value = text or ""
    return value if len(value) <= limit else value[:limit] + "\n...[truncated]"


def sanitize_text(text: str | None, sensitive_values: list[str] | None = None) -> str:
    value = text or ""
    for sensitive in sensitive_values or []:
        if sensitive:
            value = value.replace(sensitive, "<redacted-content>")
    return bounded_output(value)


def redacted_argv(argv: list[str], sensitive_values: list[str] | None = None) -> list[str]:
    return [sanitize_text(token, sensitive_values) for token in argv]


def run_process(
    argv: list[str],
    cwd: Path,
    env_overrides: dict[str, Any],
    timeout: int,
    sensitive_values: list[str] | None = None,
    timeout_code: str = "OPERATION_TIMEOUT",
) -> subprocess.CompletedProcess[str]:
    env = dict(os.environ)
    for key, value in env_overrides.items():
        if not isinstance(key, str) or not isinstance(value, (str, int, float, bool)):
            raise AiImageError("BACKEND_ENV_INVALID", "Backend environment overrides must be scalar string-compatible values", EXIT_CONFIG)
        env[key] = str(value)
    proc = subprocess.Popen(
        argv,
        cwd=str(cwd),
        env=env,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        start_new_session=True,
    )
    try:
        stdout, stderr = proc.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(proc.pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        try:
            stdout, stderr = proc.communicate(timeout=5)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(proc.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            stdout, stderr = proc.communicate()
        raise AiImageError(
            timeout_code,
            f"Image backend exceeded timeout of {timeout} seconds",
            EXIT_PROCESS,
            {"stdout": sanitize_text(stdout, sensitive_values), "stderr": sanitize_text(stderr, sensitive_values)},
        )
    return subprocess.CompletedProcess(argv, proc.returncode, sanitize_text(stdout, sensitive_values), sanitize_text(stderr, sensitive_values))


def image_dimensions(path: Path) -> tuple[int | None, int | None]:
    try:
        with path.open("rb") as f:
            head = f.read(32)
            if len(head) >= 24 and head[:8] == b"\x89PNG\r\n\x1a\n":
                return struct.unpack(">II", head[16:24])
            if len(head) >= 2 and head[:2] == b"\xff\xd8":
                f.seek(2)
                while True:
                    marker_start = f.read(1)
                    if not marker_start:
                        break
                    if marker_start != b"\xff":
                        continue
                    marker = f.read(1)
                    while marker == b"\xff":
                        marker = f.read(1)
                    if marker in {b"\xd8", b"\xd9"}:
                        continue
                    raw_len = f.read(2)
                    if len(raw_len) != 2:
                        break
                    seg_len = struct.unpack(">H", raw_len)[0]
                    if marker and marker[0] in range(0xC0, 0xC4):
                        data = f.read(5)
                        if len(data) == 5:
                            height, width = struct.unpack(">HH", data[1:5])
                            return width, height
                        break
                    f.seek(max(seg_len - 2, 0), 1)
    except OSError:
        pass
    return None, None


def detect_mflux_version() -> str | None:
    uv = shutil.which("uv")
    if not uv:
        return None
    try:
        result = subprocess.run([uv, "tool", "list"], capture_output=True, text=True, timeout=5, check=False)
    except (OSError, subprocess.SubprocessError):
        return None
    match = re.search(r"(?m)^mflux\s+v([^\s]+)", result.stdout or "")
    return match.group(1) if match else None


def version_tuple(value: str | None) -> tuple[int, ...] | None:
    if not value:
        return None
    m = re.match(r"^(\d+)(?:\.(\d+))?(?:\.(\d+))?", value)
    if not m:
        return None
    return tuple(int(x or 0) for x in m.groups())


def validate_role(cfg: dict[str, Any], role_name: str, operation: str) -> tuple[dict[str, Any], str, dict[str, Any], str]:
    role = role_config(cfg, role_name)
    if role.get("provider", "local") != "local":
        raise AiImageError("NONLOCAL_ROLE", f"Role {role_name} is not configured as local", EXIT_CONFIG)
    if not role.get("license_approved", False):
        raise AiImageError("LICENSE_NOT_APPROVED", f"Role {role_name} is not approved for production use; review model licensing first", EXIT_RUNTIME)
    model = str(role.get("model") or "")
    if not model:
        raise AiImageError("MODEL_NOT_CONFIGURED", f"Role {role_name} has no configured model", EXIT_RUNTIME)
    backend_name, backend = backend_config(cfg, role)
    if not backend.get("enabled", False):
        raise AiImageError("BACKEND_DISABLED", f"Backend {backend_name} is not enabled", EXIT_RUNTIME)
    executable = resolve_executable(str(backend.get("executable") or ""))
    if not executable:
        raise AiImageError("BACKEND_EXECUTABLE_MISSING", f"Backend executable is unavailable for {backend_name}", EXIT_RUNTIME)
    template_key = {"generate": "generate_args", "edit": "edit_args", "upscale": "upscale_args"}[operation]
    template = backend.get(template_key)
    if not isinstance(template, list) or not template:
        raise AiImageError("BACKEND_COMMAND_NOT_CONFIGURED", f"Backend {template_key} is not configured", EXIT_CONFIG)
    return role, backend_name, backend, executable


def resolve_effective_role(cfg: dict[str, Any], requested_role: str, use_fallback: bool) -> tuple[str, dict[str, Any], str | None]:
    requested = role_config(cfg, requested_role)
    if not use_fallback:
        return requested_role, requested, None
    fallback = str(requested.get("fallback_role") or "")
    if not fallback:
        raise AiImageError("FALLBACK_NOT_CONFIGURED", f"Role {requested_role} has no configured fallback role", EXIT_CONFIG)
    return fallback, role_config(cfg, fallback), requested_role


def effective_safe_config(cfg: dict[str, Any], root: Path) -> dict[str, Any]:
    roles_out: dict[str, Any] = {}
    for role_name in ROLES:
        role = cfg.get("roles", {}).get(role_name, {}) if isinstance(cfg.get("roles"), dict) else {}
        roles_out[role_name] = {
            "provider": role.get("provider"),
            "backend": role.get("backend"),
            "model": role.get("model"),
            "license_approved": bool(role.get("license_approved", False)),
            "policy": role.get("policy"),
            "fallback_role": role.get("fallback_role"),
        }
    backends_out: dict[str, Any] = {}
    for name, backend in (cfg.get("backends") or {}).items():
        if isinstance(backend, dict):
            exe = str(backend.get("executable") or "")
            backends_out[name] = {
                "enabled": bool(backend.get("enabled", False)),
                "executable": exe,
                "executable_found": bool(resolve_executable(exe)) if exe else False,
                "generate_command_configured": bool(backend.get("generate_args")),
                "edit_command_configured": bool(backend.get("edit_args")),
                "upscale_command_configured": bool(backend.get("upscale_args")),
            }
    return {
        "config_dir": str(root),
        "schema_version": cfg.get("schema_version"),
        "roles": roles_out,
        "backends": backends_out,
        "cloud_enabled": bool((cfg.get("cloud") or {}).get("enabled", False)),
        "mflux_version": detect_mflux_version(),
        "minimum_mflux_version": cfg.get("minimum_mflux_version"),
    }


def cmd_doctor(args: argparse.Namespace) -> int:
    cfg, root = load_config()
    report = effective_safe_config(cfg, root)
    blockers: list[str] = []
    warnings: list[str] = []
    ready_roles: list[str] = []
    for role_name in ROLES:
        role = report["roles"].get(role_name, {})
        if not role.get("model"):
            warnings.append(f"{role_name}: model not configured")
            continue
        if not role.get("license_approved"):
            warnings.append(f"{role_name}: model configured but license not approved")
            continue
        backend_name = role.get("backend")
        backend = report["backends"].get(backend_name, {})
        if not backend or not backend.get("enabled"):
            blockers.append(f"{role_name}: backend {backend_name} is not enabled")
            continue
        if not backend.get("executable_found"):
            blockers.append(f"{role_name}: backend {backend_name} executable not found")
            continue
        command_key = "upscale_command_configured" if role_name == "upscale" else "edit_command_configured" if role_name == "editing" else "generate_command_configured"
        if not backend.get(command_key):
            blockers.append(f"{role_name}: backend command template is not configured")
            continue
        ready_roles.append(role_name)
    if not any(r in ready_roles for r in GENERATION_ROLES):
        blockers.append("no approved local generation role is ready")
    detected = version_tuple(report.get("mflux_version"))
    minimum = version_tuple(str(report.get("minimum_mflux_version") or ""))
    if detected and minimum and detected < minimum:
        warnings.append(f"MFLUX {report['mflux_version']} is older than validated minimum {report['minimum_mflux_version']}")
    if report.get("mflux_version") is None:
        warnings.append("could not determine MFLUX version via `uv tool list`")
    report.update({"status": "ready" if not blockers else "not_ready", "ready_roles": ready_roles, "blockers": blockers, "warnings": warnings})
    safe_emit(report, args.json)
    return 0 if not blockers else EXIT_RUNTIME


def cmd_config(args: argparse.Namespace) -> int:
    cfg, root = load_config()
    payload = effective_safe_config(cfg, root)
    payload["status"] = "ok"
    safe_emit(payload, args.json)
    return 0


def cmd_policy(args: argparse.Namespace) -> int:
    cfg, _ = load_config()
    effective_name, role, fallback_from = resolve_effective_role(cfg, args.purpose, args.use_fallback)
    policy_name, policy = policy_config(cfg, role)
    payload = {
        "status": "ok",
        "requested_role": args.purpose,
        "effective_role": effective_name,
        "fallback_used": bool(fallback_from),
        "policy": policy_name,
        "acceptance_criteria": policy.get("acceptance_criteria") or [],
        "retry_guidance": policy.get("retry_guidance") or [],
    }
    safe_emit(payload, args.json)
    return 0


def prompt_from_brief(path: Path) -> str:
    if not path.is_file():
        raise AiImageError("BRIEF_NOT_FOUND", f"Brief file does not exist: {path}", EXIT_CONFIG)
    try:
        text = path.read_text(encoding="utf-8")
    except OSError as exc:
        raise AiImageError("BRIEF_READ_FAILED", f"Cannot read brief: {exc}", EXIT_CONFIG) from exc
    if not text.strip():
        raise AiImageError("BRIEF_EMPTY", "Brief file is empty", EXIT_CONFIG)
    return text.strip()


def compose_prompt(base_prompt: str, role: dict[str, Any], policy: dict[str, Any]) -> str:
    params = role.get("parameters") if isinstance(role.get("parameters"), dict) else {}
    parts = []
    for item in (policy.get("prompt_prefix"), params.get("prompt_prefix"), base_prompt, params.get("prompt_suffix"), policy.get("prompt_suffix")):
        if isinstance(item, str) and item.strip():
            parts.append(item.strip())
    return "\n\n".join(parts)


def attempt_output_path(requested: Path, quality_attempt: int, exact_output: bool) -> Path:
    if exact_output or quality_attempt <= 1:
        return requested
    suffix = requested.suffix
    stem = requested.name[:-len(suffix)] if suffix else requested.name
    return requested.with_name(f"{stem}.attempt-{quality_attempt:02d}{suffix}")


def ensure_output_available(output: Path, overwrite: bool, dry_run: bool) -> None:
    if output.exists() and not overwrite and not dry_run:
        raise AiImageError("OUTPUT_EXISTS", f"Output already exists; use --overwrite or a new path: {output}", EXIT_CONFIG)


def write_metadata(output: Path, payload: dict[str, Any], enabled: bool) -> str | None:
    if not enabled:
        return None
    sidecar = Path(str(output) + ".ai-image.json")
    temp = sidecar.with_name(sidecar.name + f".tmp-{os.getpid()}-{secrets.token_hex(4)}")
    temp.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    os.replace(temp, sidecar)
    return str(sidecar)


def safe_environment_snapshot() -> dict[str, str]:
    names = ("HF_HOME", "HF_HUB_CACHE", "MFLUX_CACHE_DIR")
    return {name: os.environ[name] for name in names if os.environ.get(name)}


def execute_with_retries(
    *,
    argv: list[str],
    cwd: Path,
    env_overrides: dict[str, Any],
    timeout: int,
    sensitive_values: list[str] | None,
    retries: int,
    output: Path,
    op_name: str,
) -> tuple[subprocess.CompletedProcess[str], int, float]:
    last_error: AiImageError | None = None
    total_attempts = max(1, retries + 1)
    start = time.monotonic()
    for attempt in range(1, total_attempts + 1):
        if output.exists():
            try:
                output.unlink()
            except OSError:
                pass
        try:
            result = run_process(argv, cwd, env_overrides, timeout, sensitive_values, f"{op_name.upper()}_TIMEOUT")
            if result.returncode != 0:
                raise AiImageError(f"{op_name.upper()}_FAILED", f"Backend exited with status {result.returncode}", EXIT_PROCESS, {"stdout": result.stdout, "stderr": result.stderr, "technical_attempt": attempt})
            if not output.is_file() or output.stat().st_size <= 0:
                raise AiImageError("OUTPUT_MISSING", f"Backend completed but output was not created: {output}", EXIT_PROCESS, {"technical_attempt": attempt, "stdout": result.stdout, "stderr": result.stderr})
            return result, attempt, round(time.monotonic() - start, 3)
        except AiImageError as exc:
            last_error = exc
            if attempt == total_attempts:
                break
            time.sleep(min(2 * attempt, 5))
    assert last_error is not None
    raise last_error


def base_metadata(cfg: dict[str, Any], *, operation: str, requested_role: str, effective_role: str, role: dict[str, Any], backend_name: str, executable: str, policy_name: str, policy: dict[str, Any], quality_attempt: int) -> dict[str, Any]:
    params = role.get("parameters") if isinstance(role.get("parameters"), dict) else {}
    sanitized_params = {k: v for k, v in params.items() if k not in {"prompt_prefix", "prompt_suffix"}}
    return {
        "metadata_schema": 2,
        "created_at_utc": utc_now(),
        "ai_image_version": VERSION,
        "mflux_version": detect_mflux_version(),
        "operation": operation,
        "requested_role": requested_role,
        "effective_role": effective_role,
        "backend": backend_name,
        "backend_executable": executable,
        "model": str(role.get("model") or ""),
        "license_note": role.get("license_note"),
        "policy": policy_name,
        "acceptance_criteria": policy.get("acceptance_criteria") or [],
        "retry_guidance": policy.get("retry_guidance") or [],
        "parameters": sanitized_params,
        "quality_attempt": quality_attempt,
        "environment": safe_environment_snapshot(),
    }


def cmd_generate(args: argparse.Namespace) -> int:
    cfg, root = load_config()
    effective_name, effective_role, fallback_from = resolve_effective_role(cfg, args.purpose, args.use_fallback)
    role, backend_name, backend, executable = validate_role(cfg, effective_name, "generate")
    policy_name, policy = policy_config(cfg, role)
    brief_path = Path(args.brief).expanduser().resolve()
    requested_output = Path(args.output).expanduser().resolve()
    output = attempt_output_path(requested_output, args.quality_attempt, args.exact_output)
    ensure_output_available(output, args.overwrite, args.dry_run)
    raw_prompt = prompt_from_brief(brief_path)
    prompt = compose_prompt(raw_prompt, role, policy)
    width, height = dimensions(cfg, args.aspect, args.quality)
    seed = int(args.seed) if args.seed is not None else secrets.randbelow(2_147_483_647)
    params = role.get("parameters") if isinstance(role.get("parameters"), dict) else {}
    mapping: dict[str, Any] = {"model": str(role.get("model")), "prompt": prompt, "brief": str(brief_path), "output": str(output), "width": width, "height": height, "seed": seed, "quality": args.quality}
    mapping.update({str(k): v for k, v in params.items()})
    argv = [executable] + format_argv(backend.get("generate_args"), mapping)
    payload = base_metadata(cfg, operation="generate", requested_role=args.purpose, effective_role=effective_name, role=role, backend_name=backend_name, executable=executable, policy_name=policy_name, policy=policy, quality_attempt=args.quality_attempt)
    payload.update({
        "status": "planned" if args.dry_run else "success",
        "config_dir": str(root),
        "requested_output": str(requested_output),
        "output": str(output),
        "fallback_used": bool(fallback_from),
        "fallback_from": fallback_from,
        "width": width,
        "height": height,
        "seed": seed,
        "brief_path": str(brief_path),
        "brief_sha256": sha256_file(brief_path),
        "prompt_sha256": sha256_text(prompt),
        "technical_attempt": 0,
        "upscaled": False,
        "warnings": [],
        "command": redacted_argv(argv, [prompt, raw_prompt]),
    })
    if args.dry_run:
        safe_emit(payload, args.json)
        return 0
    output.parent.mkdir(parents=True, exist_ok=True)
    timeout = int(backend.get("timeout_seconds") or cfg.get("default_timeout_seconds") or 900)
    retries = int(cfg.get("technical_retry_attempts") or 0)
    result, technical_attempt, duration = execute_with_retries(argv=argv, cwd=output.parent, env_overrides=backend.get("environment") or {}, timeout=timeout, sensitive_values=[prompt, raw_prompt], retries=retries, output=output, op_name="generation")
    payload["technical_attempt"] = technical_attempt
    payload["duration_seconds"] = duration
    actual_w, actual_h = image_dimensions(output)
    if actual_w and actual_h:
        payload["actual_width"], payload["actual_height"] = actual_w, actual_h
        if (actual_w, actual_h) != (width, height):
            payload["warnings"].append(f"output dimensions {actual_w}x{actual_h} differ from requested {width}x{height}")
    payload["backend_stdout"] = result.stdout
    payload["backend_stderr"] = result.stderr
    payload["metadata"] = write_metadata(output, payload, bool(cfg.get("metadata_sidecar", True)))
    safe_emit(payload, args.json)
    return 0


def cmd_edit(args: argparse.Namespace) -> int:
    cfg, root = load_config()
    role, backend_name, backend, executable = validate_role(cfg, "editing", "edit")
    policy_name, policy = policy_config(cfg, role)
    brief_path = Path(args.brief).expanduser().resolve()
    input_path = Path(args.input).expanduser().resolve()
    references = [Path(p).expanduser().resolve() for p in (args.reference or [])]
    all_images = [input_path] + references
    for image in all_images:
        if not image.is_file():
            raise AiImageError("INPUT_NOT_FOUND", f"Edit input/reference does not exist: {image}", EXIT_CONFIG)
    requested_output = Path(args.output).expanduser().resolve()
    output = attempt_output_path(requested_output, args.quality_attempt, args.exact_output)
    ensure_output_available(output, args.overwrite, args.dry_run)
    raw_prompt = prompt_from_brief(brief_path)
    prompt = compose_prompt(raw_prompt, role, policy)
    seed = int(args.seed) if args.seed is not None else secrets.randbelow(2_147_483_647)
    params = role.get("parameters") if isinstance(role.get("parameters"), dict) else {}
    mapping: dict[str, Any] = {"model": str(role.get("model")), "prompt": prompt, "brief": str(brief_path), "output": str(output), "input": str(input_path), "image_paths": [str(p) for p in all_images], "seed": seed}
    mapping.update({str(k): v for k, v in params.items()})
    argv = [executable] + format_argv(backend.get("edit_args"), mapping)
    payload = base_metadata(cfg, operation="edit", requested_role="editing", effective_role="editing", role=role, backend_name=backend_name, executable=executable, policy_name=policy_name, policy=policy, quality_attempt=args.quality_attempt)
    payload.update({
        "status": "planned" if args.dry_run else "success",
        "config_dir": str(root),
        "requested_output": str(requested_output),
        "output": str(output),
        "seed": seed,
        "brief_path": str(brief_path),
        "brief_sha256": sha256_file(brief_path),
        "prompt_sha256": sha256_text(prompt),
        "input": {"path": str(input_path), "sha256": sha256_file(input_path)},
        "references": [{"path": str(p), "sha256": sha256_file(p)} for p in references],
        "technical_attempt": 0,
        "upscaled": False,
        "warnings": [],
        "command": redacted_argv(argv, [prompt, raw_prompt]),
    })
    if args.dry_run:
        safe_emit(payload, args.json)
        return 0
    output.parent.mkdir(parents=True, exist_ok=True)
    timeout = int(backend.get("timeout_seconds") or cfg.get("default_timeout_seconds") or 900)
    retries = int(cfg.get("technical_retry_attempts") or 0)
    result, technical_attempt, duration = execute_with_retries(argv=argv, cwd=output.parent, env_overrides=backend.get("environment") or {}, timeout=timeout, sensitive_values=[prompt, raw_prompt], retries=retries, output=output, op_name="edit")
    payload["technical_attempt"] = technical_attempt
    payload["duration_seconds"] = duration
    w, h = image_dimensions(output)
    if w and h:
        payload["actual_width"], payload["actual_height"] = w, h
    payload["backend_stdout"] = result.stdout
    payload["backend_stderr"] = result.stderr
    payload["metadata"] = write_metadata(output, payload, bool(cfg.get("metadata_sidecar", True)))
    safe_emit(payload, args.json)
    return 0


def cmd_upscale(args: argparse.Namespace) -> int:
    cfg, root = load_config()
    role, backend_name, backend, executable = validate_role(cfg, "upscale", "upscale")
    policy_name, policy = policy_config(cfg, role)
    input_path = Path(args.input).expanduser().resolve()
    if not input_path.is_file():
        raise AiImageError("INPUT_NOT_FOUND", f"Input image does not exist: {input_path}", EXIT_CONFIG)
    requested_output = Path(args.output).expanduser().resolve()
    output = attempt_output_path(requested_output, args.quality_attempt, args.exact_output)
    ensure_output_available(output, args.overwrite, args.dry_run)
    params = role.get("parameters") if isinstance(role.get("parameters"), dict) else {}
    resolution = args.resolution if args.resolution is not None else params.get("resolution", "2x")
    softness = args.softness if args.softness is not None else params.get("softness", 0.5)
    mapping: dict[str, Any] = {"model": str(role.get("model")), "input": str(input_path), "output": str(output), "resolution": resolution, "softness": softness}
    mapping.update({str(k): v for k, v in params.items()})
    mapping["resolution"], mapping["softness"] = resolution, softness
    argv = [executable] + format_argv(backend.get("upscale_args"), mapping)
    payload = base_metadata(cfg, operation="upscale", requested_role="upscale", effective_role="upscale", role=role, backend_name=backend_name, executable=executable, policy_name=policy_name, policy=policy, quality_attempt=args.quality_attempt)
    payload.update({
        "status": "planned" if args.dry_run else "success",
        "config_dir": str(root),
        "requested_output": str(requested_output),
        "output": str(output),
        "input": {"path": str(input_path), "sha256": sha256_file(input_path)},
        "resolution": resolution,
        "softness": softness,
        "technical_attempt": 0,
        "upscaled": True,
        "warnings": [],
        "command": argv,
    })
    if args.dry_run:
        safe_emit(payload, args.json)
        return 0
    output.parent.mkdir(parents=True, exist_ok=True)
    timeout = int(backend.get("timeout_seconds") or cfg.get("default_timeout_seconds") or 900)
    retries = int(cfg.get("technical_retry_attempts") or 0)
    result, technical_attempt, duration = execute_with_retries(argv=argv, cwd=output.parent, env_overrides=backend.get("environment") or {}, timeout=timeout, sensitive_values=None, retries=retries, output=output, op_name="upscale")
    payload["technical_attempt"] = technical_attempt
    payload["duration_seconds"] = duration
    w, h = image_dimensions(output)
    if w and h:
        payload["actual_width"], payload["actual_height"] = w, h
    payload["backend_stdout"] = result.stdout
    payload["backend_stderr"] = result.stderr
    payload["metadata"] = write_metadata(output, payload, bool(cfg.get("metadata_sidecar", True)))
    safe_emit(payload, args.json)
    return 0


def cmd_review(args: argparse.Namespace) -> int:
    image = Path(args.input).expanduser().resolve()
    if not image.is_file():
        raise AiImageError("INPUT_NOT_FOUND", f"Reviewed image does not exist: {image}", EXIT_CONFIG)
    sidecar = Path(str(image) + ".ai-image.json")
    if not sidecar.is_file():
        raise AiImageError("METADATA_MISSING", f"No ai-image sidecar exists for reviewed image: {sidecar}", EXIT_CONFIG)
    data = load_json(sidecar, True)
    review = {
        "decision": args.decision,
        "reasons": args.reason or [],
        "reviewed_at_utc": utc_now(),
        "reviewer": args.reviewer,
    }
    data["review"] = review
    temp = sidecar.with_name(sidecar.name + f".tmp-{os.getpid()}-{secrets.token_hex(4)}")
    temp.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    os.replace(temp, sidecar)
    payload = {"status": "ok", "input": str(image), "metadata": str(sidecar), "review": review}
    safe_emit(payload, args.json)
    return 0


def cmd_promote(args: argparse.Namespace) -> int:
    """Publish an already-accepted candidate to the caller's final delivery path.

    Promotion copies bytes. It never re-runs a model, so the delivered asset is
    provably the artifact that was visually reviewed, and the candidate plus its
    review sidecar survive untouched as the audit trail.
    """
    candidate = Path(args.input).expanduser().resolve()
    if not candidate.is_file():
        raise AiImageError("INPUT_NOT_FOUND", f"Candidate image does not exist: {candidate}", EXIT_CONFIG)
    candidate_sidecar = Path(str(candidate) + ".ai-image.json")
    if not candidate_sidecar.is_file():
        raise AiImageError("METADATA_MISSING", f"No ai-image sidecar exists for candidate: {candidate_sidecar}", EXIT_CONFIG)

    data = load_json(candidate_sidecar, True)
    review = data.get("review") if isinstance(data.get("review"), dict) else None
    decision = str(review.get("decision") or "") if review else ""
    if decision != "accepted":
        raise AiImageError(
            "CANDIDATE_NOT_ACCEPTED",
            "Only a candidate whose sidecar records review.decision=accepted may be promoted; "
            f"found {decision or 'no recorded review'}: {candidate_sidecar}",
            EXIT_CONFIG,
        )

    output = Path(args.output).expanduser().resolve()
    if output == candidate:
        raise AiImageError("PROMOTION_SOURCE_IS_DESTINATION", f"Promotion destination must differ from the candidate: {output}", EXIT_CONFIG)
    ensure_output_available(output, args.overwrite, args.dry_run)

    candidate_hash = sha256_file(candidate)
    promoted_at = utc_now()
    payload = {
        "status": "ok",
        "operation": "promote",
        "ai_image_version": VERSION,
        "input": str(candidate),
        "output": str(output),
        "promoted_from": str(candidate),
        "promoted_from_sha256": candidate_hash,
        "promoted_at_utc": promoted_at,
        "quality_attempt": data.get("quality_attempt"),
        "review": review,
        "regenerated": False,
        "warnings": [],
    }
    if args.dry_run:
        safe_emit(payload, args.json)
        return 0

    output.parent.mkdir(parents=True, exist_ok=True)
    temp = output.with_name(output.name + f".tmp-{os.getpid()}-{secrets.token_hex(4)}")
    try:
        shutil.copyfile(candidate, temp)
        os.replace(temp, output)
    except OSError as exc:
        if temp.exists():
            temp.unlink(missing_ok=True)
        raise AiImageError("PROMOTION_COPY_FAILED", f"Could not publish accepted candidate: {exc}", EXIT_RUNTIME) from exc

    promoted_hash = sha256_file(output)
    if promoted_hash != candidate_hash:
        raise AiImageError(
            "PROMOTION_HASH_MISMATCH",
            f"Promoted image hash {promoted_hash} does not match accepted candidate hash {candidate_hash}",
            EXIT_RUNTIME,
        )

    # Preserve the candidate's generation/edit provenance, original quality
    # attempt, and original review verbatim; add only promotion lineage.
    final_metadata = dict(data)
    final_metadata["promoted_from"] = str(candidate)
    final_metadata["promoted_from_sha256"] = candidate_hash
    final_metadata["promoted_at_utc"] = promoted_at
    payload["sha256"] = promoted_hash
    payload["metadata"] = write_metadata(output, final_metadata, True)
    safe_emit(payload, args.json)
    return 0


def add_common_output_args(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--output", required=True)
    parser.add_argument("--quality-attempt", type=int, default=1, help="visual-quality attempt number; >1 gets a deterministic .attempt-NN suffix")
    parser.add_argument("--exact-output", action="store_true", help="disable automatic quality-attempt output suffixing")
    parser.add_argument("--overwrite", action="store_true")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--dry-run", action="store_true")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="ai-image", description="Stable local-first image generation/edit/upscale wrapper")
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("version", help="show wrapper version")
    p.set_defaults(func=lambda a: (print(VERSION), 0)[1])

    p = sub.add_parser("doctor", help="check configuration and runtime readiness")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_doctor)

    p = sub.add_parser("config", help="show safe effective configuration metadata")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_config)

    p = sub.add_parser("policy", help="show caller-visible visual acceptance policy for a role")
    p.add_argument("--purpose", required=True, choices=GENERATION_ROLES)
    p.add_argument("--use-fallback", action="store_true")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_policy)

    p = sub.add_parser("generate", help="generate one candidate image from a brief")
    p.add_argument("--brief", required=True)
    p.add_argument("--purpose", required=True, choices=GENERATION_ROLES)
    p.add_argument("--aspect", required=True)
    p.add_argument("--quality", choices=QUALITIES, default=None)
    p.add_argument("--seed", type=int)
    p.add_argument("--use-fallback", action="store_true", help="explicitly use the role's configured fallback route")
    p.add_argument("--allow-cloud", action="store_true", help="reserved for a future explicitly configured cloud provider")
    add_common_output_args(p)
    p.set_defaults(func=cmd_generate)

    p = sub.add_parser("edit", help="edit an image using one input and optional reference images")
    p.add_argument("--input", required=True)
    p.add_argument("--reference", action="append", default=[], help="additional reference image; repeat for multiple references")
    p.add_argument("--brief", required=True)
    p.add_argument("--seed", type=int)
    add_common_output_args(p)
    p.set_defaults(func=cmd_edit)

    p = sub.add_parser("upscale", help="upscale an accepted image with SeedVR2")
    p.add_argument("--input", required=True)
    p.add_argument("--resolution", help="target shortest side or scale factor, e.g. 2160 or 2x")
    p.add_argument("--softness", type=float)
    add_common_output_args(p)
    p.set_defaults(func=cmd_upscale)

    p = sub.add_parser("review", help="record an external visual review decision in the image sidecar")
    p.add_argument("--input", required=True)
    p.add_argument("--decision", required=True, choices=("accepted", "rejected"))
    p.add_argument("--reason", action="append", default=[])
    p.add_argument("--reviewer", default="external-vision-review")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_review)

    p = sub.add_parser("promote", help="publish an accepted candidate to a final delivery path by copying bytes")
    p.add_argument("--input", required=True, help="accepted candidate image whose sidecar records review.decision=accepted")
    p.add_argument("--output", required=True, help="final delivery path")
    p.add_argument("--overwrite", action="store_true", help="replace an existing destination; refused by default")
    p.add_argument("--json", action="store_true")
    p.add_argument("--dry-run", action="store_true")
    p.set_defaults(func=cmd_promote)
    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    if hasattr(args, "quality_attempt") and args.quality_attempt < 1:
        safe_emit({"status": "error", "code": "QUALITY_ATTEMPT_INVALID", "message": "--quality-attempt must be >= 1"}, bool(getattr(args, "json", False)))
        return EXIT_CONFIG
    if getattr(args, "quality", None) is None and getattr(args, "command", None) == "generate":
        try:
            cfg, _ = load_config()
            args.quality = str(cfg.get("default_quality") or "high")
        except AiImageError:
            args.quality = "high"
    try:
        return int(args.func(args))
    except AiImageError as exc:
        payload = {"status": "error", "code": exc.code, "message": exc.message}
        if exc.details:
            payload["details"] = exc.details
        safe_emit(payload, bool(getattr(args, "json", False)))
        return exc.exit_code
    except KeyboardInterrupt:
        safe_emit({"status": "error", "code": "INTERRUPTED", "message": "Image operation interrupted"}, bool(getattr(args, "json", False)))
        return EXIT_PROCESS


if __name__ == "__main__":
    raise SystemExit(main())
