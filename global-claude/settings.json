{
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm lint)",
      "Bash(pnpm test)",
      "Bash(pnpm build)",
      "Bash(pnpm typecheck)",
      "Bash(npm install)",
      "Bash(npm run lint:*)",
      "Bash(npm run ready:*)",
      "Bash(npm run test:*)",
      "Bash(npm run build:*)",
      "Bash(npm run quality:*)",
      "Bash(npm run typecheck:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(echo:*)",
      "Bash(grep:*)",
      "Bash(sed:*)",
      "Bash(head:*)",
      "Bash(cd:*)",
      "Bash(tail:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git reset --hard)",
      "Bash(git clean -fd *)",
      "Bash(vercel --prod *)",
      "Bash(supabase db push *)",
      "Bash(supabase db reset *)",
      "Bash(terraform destroy *)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "opus[1m]",
  "hooks": {
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "/Users/manish/.claude/session-continuity/hooks/precompact_snapshot.py"
            ],
            "timeout": 20,
            "statusMessage": "Saving session continuity snapshot"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "/Users/manish/.claude/session-continuity/hooks/sessionstart_compact_reinject.py"
            ],
            "timeout": 20,
            "statusMessage": "Restoring compaction anchor"
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [],
            "timeout": 20,
            "statusMessage": "Checking for a task handoff"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/manish/.claude/hooks/claude-turn-notify.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/manish/.claude/hooks/claude-turn-notify.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/manish/.claude/hooks/claude-turn-notify.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/manish/.claude/hooks/claude-turn-notify.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh ~/.claude/statusline-command.sh"
  },
  "outputStyle": "Engineering Narrator",
  "viewMode": "default",
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "autoCompactWindow": 800000,
  "remote": {
    "defaultEnvironmentId": "env_017RtrrRy8mK6G7Woa3du5AT"
  },
  "voice": {
    "enabled": false,
    "mode": "hold"
  },
  "showThinkingSummaries": false,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "verbose": false,
  "voiceEnabled": false
}
